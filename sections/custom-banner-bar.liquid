      </svg>
    </div>

    <!-- Image & Content Blocks -->
    <div class="custom-grid">
      {%- for block in section.blocks -%}
        <div class="custom-grid-item" {{ block.shopify_attributes }}>
          <div class="image-card">
            {%- if block.settings.image != blank -%}
              <img src="{{ block.settings.image | img_url: 'master' }}" alt="{{ block.settings.title | escape }}" loading="lazy" width="{{ block.settings.image.width }}" height="{{ block.settings.image.height }}">
            {%- else -%}
              {{ 'lifestyle-1' | placeholder_svg_tag: 'placeholder-svg' }}
            {%- endif -%}
            
            {%- if block.settings.title != blank -%}
              <h3 class="item-title">{{ block.settings.title }}</h3>
            {%- endif -%}
          </div>
        </div>
      {%- endfor -%}
    </div>

  </div>
</div>

{% schema %}
{
  "name": "Custom Dynamic Grid",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading Text",
      "default": "Own Better."
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheading Text",
      "default": "The essentials you carry every day deserve more thought."
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#f4f6f0"
    }
  ],
  "blocks": [
    {
      "type": "item",
      "name": "Grid Item",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Select Image"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Item Title",
          "default": "Strawberry Matcha"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Custom Dynamic Grid",
      "blocks": [
        {
          "type": "item",
          "settings": {
            "title": "Strawberry Matcha"
          }
        },
        {
          "type": "item",
          "settings": {
            "title": "Matcha Latte"
          }
        },
        {
          "type": "item",
          "settings": {
            "title": "Maple Matcha"
          }
        }
      ]
    }
  ]
}
{% endschema %}