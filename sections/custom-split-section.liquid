{% comment %}
  Custom Dynamic Split Section with Social Icons
  Fully Responsive & Schema Configurable
{% endcomment %}

<div class="custom-split-section section-{{ section.id }}">
  <div class="split-container">
    
    <!-- LEFT SIDE: Dynamic Content Block -->
    <div class="split-left">
      {% if section.settings.left_image != blank %}
        <div class="left-image-wrapper">
          <img 
            src="{{ section.settings.left_image | image_url: width: 1000 }}" 
            alt="{{ section.settings.left_image.alt | escape }}"
            loading="lazy"
            width="{{ section.settings.left_image.width }}"
            height="{{ section.settings.left_image.height }}"
          >
        </div>
      {% else %}
        <div class="left-content-placeholder">
          <h3>{{ section.settings.left_title | default: "Left Side Content" }}</h3>
          <p>{{ section.settings.left_text }}</p>
        </div>
      {% endif %}
    </div>

    <!-- RIGHT SIDE: Heading, Subtext, and Social Icons -->
    <div class="split-right">
      <div class="right-content-box">
        {% if section.settings.right_heading != blank %}
            <p>{{ section.settings.right_Abouttag }}</p>
          <h2 class="right-heading">{{ section.settings.right_heading }}</h2>
        {% endif %}
        
        {% if section.settings.right_subtext != blank %}
          <div class="right-subtext">
            {{ section.settings.right_subtext }}
          </div>
        {% endif %}

        <!-- Social Icons Section -->
        <div class="social-icons-wrapper">
          {% if section.settings.social_icon_1 != blank %}
            <a href="{{ section.settings.social_link_1 | default: '#' }}" class="social-icon-link" target="_blank">
              <img src="{{ section.settings.social_icon_1 | image_url: width: 50 }}" alt="Social Icon 1" loading="lazy">
            </a>
          {% endif %}
          
          {% if section.settings.social_icon_2 != blank %}
            <a href="{{ section.settings.social_link_2 | default: '#' }}" class="social-icon-link" target="_blank">
              <img src="{{ section.settings.social_icon_2 | image_url: width: 50 }}" alt="Social Icon 2" loading="lazy">
            </a>
          {% endif %}
          
          {% if section.settings.social_icon_3 != blank %}
            <a href="{{ section.settings.social_link_3 | default: '#' }}" class="social-icon-link" target="_blank">
              <img src="{{ section.settings.social_icon_3 | image_url: width: 50 }}" alt="Social Icon 3" loading="lazy">
            </a>
          {% endif %}
          
          {% if section.settings.social_icon_4 != blank %}
            <a href="{{ section.settings.social_link_4 | default: '#' }}" class="social-icon-link" target="_blank">
              <img src="{{ section.settings.social_icon_4 | image_url: width: 50 }}" alt="Social Icon 4" loading="lazy">
            </a>
          {% endif %}
        </div>
      </div>
    </div>

  </div>
</div>

{% style %}
  /* Section Padding & Styling */
  .section-{{ section.id }} {
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
    background-color: {{ section.settings.bg_color }};
    width: 100%;
    overflow: hidden;
  }

  .split-container {
    max-width: 1800px;
    margin: 0 auto;
    padding: 0 20px;
    display: flex;
    flex-wrap: wrap;
    gap: 40px;
    align-items: flex-start; /* Yaha center se flex-start kiya taaki content top par alignment me rahe */
  }

  /* Base Columns Width */
  .split-left, .split-right {
    flex: 1 1 calc(50% - 20px);
    width: 50%;
    box-sizing: border-box;
  }

  /* Left Side Styles */
  .left-image-wrapper img {
    width: 40%; /* Yaha 50% se 100% kiya taaki image container me achhe se set ho sake */
    height: auto;
    display: block;
    border-radius: 8px;
    object-fit: cover;
    margin-top: 20px;
  }
  
  .left-content-placeholder {
    padding: 40px;
    background: #f4f4f4;
    border-radius: 8px;
  }

  /* Right Side Styles */
  .right-content-box {
    padding: 20px;
  }

  .right-content-box p {
    font-size: 17px;
    color: {{ section.settings.text_color | color_modify: 'alpha', 0.7 }};
    margin-bottom: -10px;
  }

  .right-heading {
    font-size: 2.5rem;
    font-weight: 700;
    margin-bottom: 15px;
    color: {{ section.settings.text_color }};
    line-height: 1.2;
  }

  .right-subtext {
    font-size: 1.1rem;
    line-height: 1.4;
    margin-bottom: 15px;
    color: {{ section.settings.text_color | color_modify: 'alpha', 0.8 }};
  }

  /* Social Icons Styling */
  .social-icons-wrapper {
    display: flex;
    gap: 15px;
    flex-wrap: wrap;
    align-items: center;
  }

  .social-icon-link {
    display: inline-block;
    transition: transform 0.3s ease;
  }

  .social-icon-link:hover {
    transform: translateY(-3px);
  }

  .social-icon-link img {
    width: 25px;
    height: 18px;
    object-fit: contain;
    display: block;
  }

  /* --- RESPONSIVENESS (All Screen Breakpoints) --- */

  /* Large Desktops (1440px and down) */
  @media screen and (max-width: 1440px) {
    .split-container {
      max-width: 1240px;
    }
  }

  /* Laptops / Smaller Desktops (1240px and down) */
  @media screen and (max-width: 1240px) {
    .right-heading {
      font-size: 2.2rem;
    }
  }

  /* Tablets - Landscape (1024px and down) */
  @media screen and (max-width: 1024px) {
    .split-container {
      gap: 30px;
    }
    .right-heading {
      font-size: 2rem;
    }
  }

  /* Tablets - Portrait (768px and down) */
  @media screen and (max-width: 768px) {
    .split-container {
      flex-direction: column; /* Stack vertically */
    }
    .split-left, .split-right {
      width: 100%;
      flex: 1 1 100%;
    }
    .right-content-box {
      padding: 10px 0;
    }
    .right-heading {
      font-size: 1.8rem;
    }
  }

  /* Mobile Devices (480px and down) */
  @media screen and (max-width: 480px) {
    .section-{{ section.id }} {
      padding-top: {{ section.settings.padding_top | divided_by: 2 }}px;
      padding-bottom: {{ section.settings.padding_bottom | divided_by: 2 }}px;
    }
    .right-heading {
      font-size: 1.5rem;
      text-align: center;
    }
    .right-subtext {
      font-size: 1rem;
      text-align: center;
    }
    .social-icons-wrapper {
      justify-content: center;
      gap: 12px;
    }
    .social-icon-link img {
      width: 35px;
      height: 35px;
    }
  }
{% endstyle %}

{% schema %}
{
  "name": "About section",
  "settings": [
    {
      "type": "header",
      "content": "Left Side Configuration"
    },
    {
      "type": "image_picker",
      "id": "left_image",
      "label": "Left Side Image",
      "info": "Upload an image to show on the left side"
    },
    {
      "type": "text",
      "id": "left_title",
      "label": "Fallback Left Title",
      "default": "Left Content"
    },
    {
      "type": "textarea",
      "id": "left_text",
      "label": "Fallback Left Text"
    },
    {
      "type": "header",
      "content": "Right Side Content"
    },
    {
        "type": "text",
        "id": "right_Abouttag",
        "label": "About Tag / Short Description",
        "default": "Your About Tag Here"
    },
    {
      "type": "text",
      "id": "right_heading",
      "label": "Heading",
      "default": "Your Heading Here"
    },
    {
      "type": "richtext",
      "id": "right_subtext",
      "label": "Subtext / Description",
      "default": "<p>Add your detailed subtext or description here paragraph style.</p>"
    },
    {
      "type": "header",
      "content": "Social Media Icons (Images)"
    },
    {
      "type": "image_picker",
      "id": "social_icon_1",
      "label": "Social Icon 1"
    },
    {
      "type": "url",
      "id": "social_link_1",
      "label": "Social Link 1"
    },
    {
      "type": "image_picker",
      "id": "social_icon_2",
      "label": "Social Icon 2"
    },
    {
      "type": "url",
      "id": "social_link_2",
      "label": "Social Link 2"
    },
    {
      "type": "image_picker",
      "id": "social_icon_3",
      "label": "Social Icon 3"
    },
    {
      "type": "url",
      "id": "social_link_3",
      "label": "Social Link 3"
    },
    {
      "type": "image_picker",
      "id": "social_icon_4",
      "label": "Social Icon 4"
    },
    {
      "type": "url",
      "id": "social_link_4",
      "label": "Social Link 4"
    },
    {
      "type": "header",
      "content": "Section Styling & Colors"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#121212"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding Top",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding Bottom",
      "default": 40
    }
  ],
  "presets": [
    {
      "name": "About section"
    }
  ]
}
{% endschema %}