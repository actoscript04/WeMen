{% comment %}
  Custom Dynamic & Responsive Footer - Fixed Social Media Images
{% endcomment %}

<style>
    .custom-footer-{{ section.id }} {
      background-color: {{ section.settings.bg_color }};
      color: {{ section.settings.text_color }};
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
      position: relative;
      overflow: hidden;
      font-size: {{ section.settings.font_size_base }}px;
      font-family: inherit;
    }

    .footer-container {
      max-width: 1440px;
      margin: 0 auto;
      padding: 0 20px;
      display: flex;
      flex-wrap: wrap;
    }

    .footer-left-content {
      flex: 1 1 60%;
      display: flex;
      flex-direction: column;
      justify-content: space-between;
      z-index: 2;
    }

    .footer-links-grid {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 20px;
      margin-bottom: 30px;
    }

    .footer-column h4 {
      font-size: 14px;
      font-weight: 700;
      text-transform: uppercase;
      margin-bottom: 20px;
      letter-spacing: 1px;
      color: {{ section.settings.heading_color }};
    }

    .footer-column ul {
      list-style: none;
      padding: 0;
      margin: 0;
    }

    .footer-column ul li {
      margin-bottom: 12px;
    }

    .footer-column ul li a {
      color: {{ section.settings.text_color }};
      text-decoration: none;
      transition: opacity 0.3s ease;
      font-size: {{ section.settings.font_size_links }}px;
    }

    .footer-column ul li a:hover {
      opacity: 0.7;
    }

    /* Bottom Row: Newsletter & Socials */
    .footer-bottom-row {
      display: flex;
      flex-wrap: wrap;
      justify-content: space-between;
      gap: 70px;
    }

    .footer-newsletter {
      flex: 1 1 auto;
      max-width: 450px;
    }

    .footer-newsletter h3 {
      font-size: 18px;
      font-weight: 700;
      line-height: 1.3;
      margin-bottom: 25px;
      text-transform: uppercase;
    }

    .newsletter-form-group {
      position: relative;
      border-bottom: 1px solid {{ section.settings.text_color }};
      display: flex;
      align-items: center;
      margin-bottom: 20px;
    }

    .newsletter-form-group input[type="email"] {
      width: 100%;
      background: transparent;
      border: none;
      padding: 10px 0;
      color: {{ section.settings.text_color }};
      font-size: 14px;
      outline: none;
    }

    .newsletter-submit-btn {
      background: #FFFBF0;
      color: #481118;
      border: none;
      padding: 5px 12px;
      cursor: pointer;
      font-size: 16px;
      display: flex;
      align-items: center;
      justify-content: center;
    }

    .newsletter-terms {
      font-size: 14px;
      line-height: 1.5;
      opacity: 0.7;
    }

    .newsletter-terms a {
      color: {{ section.settings.text_color }};
    }

    /* Center Social Media Section */
    .footer-social-media {
      flex: 0 1 auto;
    }

    .social-title {
      font-size: 16px;
      font-weight: 700;
      text-transform: uppercase;
      margin-bottom: 15px;
      letter-spacing: 1px;
    }

    .social-icons-wrapper {
      display: flex;
      gap: 20px;
      flex-wrap: wrap;
      align-items: center;
    }

    .social-icon-item {
      color: {{ section.settings.text_color }};
      text-decoration: none;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      transition: transform 0.2s ease, opacity 0.3s ease;
    }

    .social-icon-item:hover {
      opacity: 0.7;
      transform: translateY(-2px);
    }

    /* Fixed CSS for Image Scaling */
    .social-icon-item img {
      width: 24px;
      height: 24px;
      object-fit: contain;
      display: block;
    }

    /* Right Side Image Styling */
    .footer-right-image {
      flex: 1 1 35%;
      position: absolute;
      right: -15%;
      bottom: -0%;
      top: 0;
      width: 35%;
      display: flex;
      align-items: flex-end;
      justify-content: flex-end;
      z-index: 1;
      transform: rotate(2deg);
    }

    .footer-right-image img {
      max-width: 90%;
      max-height: 100%;
      object-fit: cover;
      display: block;
      opacity: 0.1;
      transform: scaleX(-1);
    }

    /* --- Responsive Breakpoints (All Screen Sizes) --- */
    @media (max-width: 1199px) {
      .footer-links-grid {
        grid-template-columns: repeat(2, 1fr);
      }
      .footer-left-content {
        flex: 1 1 60%;
      }
      .footer-right-image {
        width: 38%;
      }
    }

    @media (max-width: 991px) {
      .custom-footer-{{ section.id }} {
        padding-bottom: 0;
      }
      .footer-left-content {
        flex: 1 1 100%;
      }
      .footer-right-image {
        position: relative;
        width: 100%;
        margin-top: 40px;
        justify-content: center;
      }
      .footer-right-image img {
        width: 100%;
        height: auto;
        max-height: 450px;
      }
      .footer-bottom-row {
        flex-direction: column;
        gap: 30px;
      }
      .footer-newsletter, .footer-social-media {
        max-width: 100%;
        flex: 1 1 100%;
      }
    }

    .footer-mobile-logo {
      display: none;
      margin-bottom: 30px;
      text-align: left;
    }
    .footer-mobile-logo img {
      max-width: 150px;
      height: auto;
      display: block;
    }
    
    .footer-accordion-icon {
      display: none;
      font-size: 24px;
      line-height: 1;
      font-weight: 300;
      transition: transform 0.3s ease;
    }

    @media (max-width: 575px) {
      .footer-mobile-logo {
        display: block;
      }
      .footer-right-image {
        display: none !important;
      }
      .footer-links-grid {
        grid-template-columns: 1fr;
        gap: 0;
      }
      .footer-column {
        border-bottom: 1px solid rgba(128,128,128,0.3);
      }
      .footer-column h4 {
        margin-bottom: 0;
        padding: 16px 0;
        display: flex;
        justify-content: space-between;
        align-items: center;
        cursor: pointer;
      }
      .footer-accordion-icon {
        display: block;
      }
      .footer-accordion-content {
        max-height: 0;
        overflow: hidden;
        transition: max-height 0.3s ease, padding-bottom 0.3s ease;
      }
      .footer-column.active .footer-accordion-content {
        max-height: 600px;
        padding-bottom: 16px;
      }
      .footer-column.active .footer-accordion-icon {
        transform: rotate(45deg);
      }
      .footer-newsletter h3 {
        font-size: 18px;
      }
    }
    .newsletter-form-group input[type="email"]::placeholder {
      color: #FFFBF0;
    }
    .as-footer-divider{
     margin-bottom: 50px;
     opacity: 0.2;
  }
</style>

<footer class="custom-footer-{{ section.id }}">
  <div class="footer-container">
    <!-- Left Area (Links + Newsletter + Socials) -->
    <div class="footer-left-content">
      
      <!-- Mobile Logo -->
      {%- if section.settings.mobile_logo != blank -%}
        <div class="footer-mobile-logo">
          <img src="{{ section.settings.mobile_logo | image_url: width: 300 }}" alt="{{ shop.name }}" loading="lazy">
        </div>
      {%- endif -%}

      <!-- Navigation Blocks -->
      <div class="footer-links-grid">
        {%- for block in section.blocks -%}
          {%- if block.type == 'link_list' -%}
            <div class="footer-column" {{ block.shopify_attributes }}>
              <h4 class="footer-accordion-toggle">
                {{ block.settings.heading | escape }}
                <span class="footer-accordion-icon">+</span>
              </h4>
              {%- if block.settings.menu != blank -%}
                <ul class="footer-accordion-content">
                  {%- for link in block.settings.menu.links -%}
                    <li>
                      <a href="{{ link.url }}">{{ link.title }}</a>
                    </li>
                  {%- endfor -%}
                </ul>
              {%- endif -%}
            </div>
          {%- endif -%}
        {%- endfor -%}
      </div>

      <div>
        <hr class="as-footer-divider">
      </div>

      <!-- Bottom Form & Social Media -->
      <div class="footer-bottom-row">
        <!-- Newsletter Section -->
        <div class="footer-newsletter">
          <h3>{{ section.settings.newsletter_heading }}</h3>

          {%- form 'customer', id: 'FooterNewsletterForm', class: 'footer-newsletter-form' -%}
            <input type="hidden" name="contact[tags]" value="newsletter">
            <div class="newsletter-form-group">
              <input 
                type="email" 
                name="contact[email]" 
                placeholder="user@gmail.com*" 
                required 
                value="{{ form.email }}"
                aria-required="true"
                autocorrect="off"
                autocapitalize="off"
              >
              <button type="submit" class="newsletter-submit-btn" aria-label="Subscribe">
                <svg height="25px" width="25px" version="1.1" id="_x32_" xmlns="http://www.w3.org/2000/svg" xmlns:xlink="http://www.w3.org/1999/xlink" viewBox="0 0 512 512" xml:space="preserve" fill="#481118" stroke="#481118"><g id="SVGRepo_bgCarrier" stroke-width="0"></g><g id="SVGRepo_tracerCarrier" stroke-linecap="round" stroke-linejoin="round"></g><g id="SVGRepo_iconCarrier"> <style type="text/css"> .st0{fill:#481118;} </style> <g> <path class="st0" d="M510.746,110.361c-2.128-10.754-6.926-20.918-13.926-29.463c-1.422-1.794-2.909-3.39-4.535-5.009 c-12.454-12.52-29.778-19.701-47.531-19.701H67.244c-17.951,0-34.834,7-47.539,19.708c-1.608,1.604-3.099,3.216-4.575,5.067 c-6.97,8.509-11.747,18.659-13.824,29.428C0.438,114.62,0,119.002,0,123.435v265.137c0,9.224,1.874,18.206,5.589,26.745 c3.215,7.583,8.093,14.772,14.112,20.788c1.516,1.509,3.022,2.901,4.63,4.258c12.034,9.966,27.272,15.45,42.913,15.45h377.51 c15.742,0,30.965-5.505,42.967-15.56c1.604-1.298,3.091-2.661,4.578-4.148c5.818-5.812,10.442-12.49,13.766-19.854l0.438-1.05 c3.646-8.377,5.497-17.33,5.497-26.628V123.435C512,119.06,511.578,114.649,510.746,110.361z M34.823,99.104 c0.951-1.392,2.165-2.821,3.714-4.382c7.689-7.685,17.886-11.914,28.706-11.914h377.51c10.915,0,21.115,4.236,28.719,11.929 c1.313,1.327,2.567,2.8,3.661,4.272l2.887,3.88l-201.5,175.616c-6.212,5.446-14.21,8.443-22.523,8.443 c-8.231,0-16.222-2.99-22.508-8.436L32.19,102.939L34.823,99.104z M26.755,390.913c-0.109-0.722-0.134-1.524-0.134-2.341V128.925 l156.37,136.411L28.199,400.297L26.755,390.913z M464.899,423.84c-6.052,3.492-13.022,5.344-20.145,5.344H67.244 c-7.127,0-14.094-1.852-20.142-5.344l-6.328-3.668l159.936-139.379l17.528,15.246c10.514,9.128,23.922,14.16,37.761,14.16 c13.89,0,27.32-5.032,37.827-14.16l17.521-15.253L471.228,420.18L464.899,423.84z M485.372,388.572 c0,0.803-0.015,1.597-0.116,2.304l-1.386,9.472L329.012,265.409l156.36-136.418V388.572z"></path> </g> </g></svg>  </span>
              </button>

            </div>


            {%- if form.posted_successfully? -%}
              <p style="color: green; font-size: 14px;">Thank you for subscribing!</p>
            {%- endif -%}
          {%- endform -%}

          <div class="newsletter-terms">
            {{ section.settings.newsletter_terms }}
          </div>
        </div>

        <!-- Dynamic Social Media Section -->
        <div class="footer-social-media">
          {%- if section.settings.social_title != blank -%}
            <div class="social-title">{{ section.settings.social_title }}</div>
          {%- endif -%}
          
          <div class="social-icons-wrapper">
            {%- for block in section.blocks -%}
              {%- if block.type == 'social_icon' and block.settings.social_link != blank -%}
                  <a
                    href="{{ block.settings.social_link }}"
                    class="social-icon-item"
                    target="_blank"
                    aria-label="{{ block.settings.social_name }}"
                    {{ block.shopify_attributes }}
                  >
                    {%- if block.settings.social_svg != blank -%}
                      <img
                        src="{{ block.settings.social_svg | image_url: width: 60 }}"
                        alt="{{ block.settings.social_name }}"
                        loading="lazy"
                      >
                    {%- else -%}
                      <span>{{ block.settings.social_name }}</span>
                    {%- endif -%}
                  </a>
              {%- endif -%}
            {%- endfor -%}
          </div>
        </div>
      </div>
    </div>

    <!-- Right Side Dynamic Banner Image -->
    {%- if section.settings.right_image != blank -%}
      <div class="footer-right-image">
        <picture>
          <source media="(max-width: 767px)" srcset="{{ section.settings.right_image | image_url: width: 700 }}">
          <source media="(max-width: 1024px)" srcset="{{ section.settings.right_image | image_url: width: 1000 }}">
          <img src="{{ section.settings.right_image | image_url: width: 1200 }}" alt="Footer Banner" loading="lazy">
        </picture>
      </div>
    {%- endif -%}
  </div>
  <div class="footer-copyright-wrapper">
    <hr class="as-footer-divider">
    <div class="footer-copyright-text">
      © 2026 WeMen. All Rights Reserved. Made With ♥ <a href="https://actoscript.com/" target="_blank" style="color: inherit; text-decoration: none;">by Actoscript | A Right Click</a>
    </div>
  </div>
</footer>

<style>
  .footer-copyright-wrapper {
    max-width: 1400px; 
    margin: 0 auto; 
    margin-top: 50px;
  }
  .footer-copyright-text {
    text-align: center; 
    font-size: 13px; 
    opacity: 0.7; 
    margin-top: -35px;
  }
  @media (max-width: 991px) {
    .footer-bottom-row {
      display: block !important;
      width: 100% !important;
    }
    .footer-newsletter {
      width: 100% !important;
      max-width: 100% !important;
      margin-bottom: 40px !important;
    }
    .footer-social-media {
      width: 100% !important;
      max-width: 100% !important;
    }
  }
  @media (max-width: 575px) {
    .footer-copyright-wrapper {
      margin-top: 20px;
    }
    .as-footer-divider {
      margin-bottom: 30px;
    }
    .footer-copyright-text {
      margin-top: -15px;
    }
    .footer-newsletter {
      margin-bottom: 30px !important;
    }
  }
</style>

<script>
  document.addEventListener('DOMContentLoaded', function() {
    const accordionToggles = document.querySelectorAll('.footer-accordion-toggle');
    accordionToggles.forEach(toggle => {
      toggle.addEventListener('click', function() {
        if (window.innerWidth <= 575) {
          const parent = this.parentElement;
          // Toggle active class
          parent.classList.toggle('active');
        }
      });
    });
  });
</script>

{% schema %}
{
  "name": "Dynamic Footer (Custom)",
  "settings": [
    {
      "type": "header",
      "content": "Color Styling"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#f9f9f9"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text/Links Color",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Column Heading Color",
      "default": "#000000"
    },
    {
      "type": "header",
      "content": "Typography & Spacing"
    },
    {
      "type": "range",
      "id": "font_size_base",
      "min": 12,
      "max": 18,
      "step": 1,
      "unit": "px",
      "label": "Base Font Size",
      "default": 14
    },
    {
      "type": "range",
      "id": "font_size_links",
      "min": 12,
      "max": 16,
      "step": 1,
      "unit": "px",
      "label": "Menu Links Font Size",
      "default": 13
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 20,
      "max": 100,
      "step": 5,
      "unit": "px",
      "label": "Padding Top",
      "default": 60
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 20,
      "max": 100,
      "step": 5,
      "unit": "px",
      "label": "Padding Bottom",
      "default": 60
    },
    {
      "type": "header",
      "content": "Newsletter Settings"
    },
    {
      "type": "text",
      "id": "newsletter_heading",
      "label": "Newsletter Title",
      "default": "10% OFF YOUR FIRST ORDER JOIN THE A-LIST"
    },
    {
      "type": "richtext",
      "id": "newsletter_terms",
      "label": "Terms & Conditions Text",
      "default": "<p>By subscribing you agree with our Terms & Conditions and Privacy Policy.</p>"
    },
    {
      "type": "header",
      "content": "Social Media Heading"
    },
    {
      "type": "text",
      "id": "social_title",
      "label": "Social Section Title",
      "default": "FOLLOW US"
    },
    {
      "type": "header",
      "content": "Right Side Feature Image"
    },
    {
      "type": "image_picker",
      "id": "right_image",
      "label": "Footer Right Image (Desktop)"
    },
    {
      "type": "header",
      "content": "Mobile Branding"
    },
    {
      "type": "image_picker",
      "id": "mobile_logo",
      "label": "Mobile Logo (Shows only on mobile)"
    }
  ],
  "blocks": [
    {
      "type": "link_list",
      "name": "Menu Column",
      "limit": 4,
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "Quick Links"
        },
        {
          "type": "link_list",
          "id": "menu",
          "label": "Select Menu"
        }
      ]
    },
    {
      "type": "social_icon",
      "name": "Social Media Icon",
      "settings": [
        {
          "type": "text",
          "id": "social_name",
          "label": "Social Platform Name",
          "default": "Instagram"
        },
        {
          "type": "url",
          "id": "social_link",
          "label": "Social URL"
        },
        {
          "type": "image_picker",
          "id": "social_svg",
          "label": "Social Icon Image",
          "info": "Upload PNG, JPG or SVG icon file here."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Dynamic AllSaints Footer V3",
      "blocks": [
        { "type": "link_list", "settings": { "heading": "HELP" } },
        { "type": "link_list", "settings": { "heading": "WE ARE ALLSAINTS" } },
        { "type": "link_list", "settings": { "heading": "INFORMATION" } },
        { "type": "link_list", "settings": { "heading": "CORPORATE & LEGAL" } }
      ]
    }
  ]
}
{% endschema %}
