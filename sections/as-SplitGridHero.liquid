{% comment %}
  Tommy Hilfiger Style Split Hero & Grid Section
  100% Dynamic & Fully Responsive
{% endcomment %}

<div class="tommy-section-wrapper section-{{ section.id }}">
  <div class="tommy-container">
    
    <!-- LEFT SIDE: Hero Banner with Overlay Text -->
    <div class="tommy-hero-banner">
      {% if section.settings.left_image != blank %}
        <img src="{{ section.settings.left_image | image_url: width: 1000 }}" alt="{{ section.settings.left_image.alt | escape }}" loading="lazy" class="hero-img">
      {% else %}
        {{ 'image' | placeholder_svg_tag: 'placeholder-svg hero-img' }}
      {% endif %}
      
      <div class="hero-overlay-content">
        {% if section.settings.sub_title != blank %}
          <span class="hero-subtitle">{{ section.settings.sub_title }}</span>
        {% endif %}
        {% if section.settings.title != blank %}
          <h2 class="hero-title">{{ section.settings.title }}</h2>
        {% endif %}
        {% if section.settings.description != blank %}
          <p class="hero-desc">{{ section.settings.description }}</p>
        {% endif %}
        
        <div class="hero-buttons">
          {% if section.settings.btn1_text != blank %}
            <a href="{{ section.settings.btn1_link }}" class="tommy-btn">{{ section.settings.btn1_text }}</a>
          {% endif %}
          {% if section.settings.btn2_text != blank %}
            <a href="{{ section.settings.btn2_link }}" class="tommy-btn">{{ section.settings.btn2_text }}</a>
          {% endif %}
        </div>
      </div>
    </div>

    <!-- RIGHT SIDE: Dynamic Image Grid -->
    <div class="tommy-image-grid">
      {% for block in section.blocks %}
        <div class="grid-item" {{ block.shopify_attributes }}>
          {% if block.settings.link != blank %}<a href="{{ block.settings.link }}">{% endif %}
            {% if block.settings.grid_image != blank %}
              <img src="{{ block.settings.grid_image | image_url: width: 400 }}" alt="{{ block.settings.grid_image.alt | escape }}" loading="lazy">
            {% else %}
              {{ 'collection-1' | placeholder_svg_tag: 'placeholder-svg' }}
            {% endif %}
          {% if block.settings.link != blank %}</a>{% endif %}
        </div>
      {% endfor %}
    </div>

  </div>
</div>

{% style %}
.section-{{ section.id }} {
  padding-top: {{ section.settings.padding_top }}px;
  padding-bottom: {{ section.settings.padding_bottom }}px;
  background-color: {{ section.settings.bg_color }};
}

/* Base Styles & Grid */
.tommy-container {
  display: grid;
  grid-template-columns: 1fr;
  gap: 15px;
  width: 100%;
  max-width: 1440px;
  margin: 0 auto;
  box-sizing: border-box;
}

@media (min-width: 769px) {
  .tommy-container {
    grid-template-columns: 1fr 1fr; /* 50% Left, 50% Right split */
    gap: 20px;
    padding: 0 20px;
  }
}

/* Left Hero Banner */
.tommy-hero-banner {
  position: relative;
  width: 100%;
  height: 100%;
  min-height: 500px;
  overflow: hidden;
  display: flex;
  align-items: center;
  justify-content: center;
}

.tommy-hero-banner .hero-img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  position: absolute;
  top: 0;
  left: 0;
}

.hero-overlay-content {
  position: relative;
  z-index: 2;
  text-align: center;
  color: #ffffff; /* Default text color agar dark image ho to */
  padding: 20px;
  width: 100%;
  height: 100%;
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;
}

/* Custom text override based on settings */
.section-{{ section.id }} .hero-overlay-content {
  color: {{ section.settings.text_color }};
}

.hero-subtitle {
  font-size: 14px;
  text-transform: uppercase;
  letter-spacing: 2px;
  margin-bottom: 5px;
  font-family: inherit;
}

.hero-title {
  font-size: 42px;
  font-weight: 700;
  margin: 0 0 10px 0;
  text-transform: uppercase;
  letter-spacing: 1px;
}

.hero-desc {
  font-size: 12px;
  margin-bottom: 30px;
  max-width: 80%;
}

/* Floating/Bottom Buttons Style like SS */
.hero-buttons {
  display: flex;
  gap: 10px;
  margin-top: auto; /* Pushes buttons to the bottom if content allows */
  padding-bottom: 40px;
}

.tommy-btn {
  background: #ffffff;
  color: #000000;
  padding: 8px 20px;
  text-decoration: none;
  font-size: 12px;
  font-weight: 600;
  border: 1px solid #000000;
  transition: all 0.3s ease;
  text-transform: capitalize;
}

.tommy-btn:hover {
  background: #000000;
  color: #ffffff;
}

/* Right Side Photo Grid */
.tommy-image-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr); /* 4 Columns standard */
  gap: 10px;
  align-content: start;
}

/* Mobile responsive adjustments */
@media (max-width: 480px) {
  .tommy-image-grid {
    grid-template-columns: repeat(2, 1fr); /* Mobile par 2 columns taaki image clear dikhe */
    gap: 8px;
  }
  .hero-title {
    font-size: 32px;
  }
}

.grid-item {
  position: relative;
  aspect-ratio: 3 / 4; /* Portrait ratio like Tommy Hilfiger layout */
  overflow: hidden;
  background-color: #f5f5f5;
}

.grid-item img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  transition: transform 0.5s ease;
      filter: grayscale(1);
}

.grid-item:hover img {
  transform: scale(1.03);
}

.placeholder-svg {
  width: 100%;
  height: 100%;
  background: #ececec;
}
{% endstyle %}

