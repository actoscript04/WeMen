        { "type": "grid_image" },
        { "type": "grid_image" },
        { "type": "grid_image" },
        { "type": "grid_image" },
        { "type": "grid_image" },
        { "type": "grid_image" },
        { "type": "grid_image" },
        { "type": "grid_image" },
        { "type": "grid_image" },
        { "type": "grid_image" }
      ]
    }
  ]
