{% comment %}
  Section: Custom Hero Banner Poster Style
  Description: Two-tone split section with huge main title, right-aligned subtext, and bottom-left watermark icon.
{% endcomment %}

<div class="hero-poster-section section-{{ section.id }}" style="
  --bg-top: {{ section.settings.bg_color_top }};
  --bg-bottom: {{ section.settings.bg_color_bottom }};
  --text-top: {{ section.settings.text_color_top }};
  --text-bottom: {{ section.settings.text_color_bottom }};
  --subtext-color: {{ section.settings.subtext_color }};
">
  <!-- Top Split Block -->
  <div class="poster-top-half">
    <div class="poster-container">
      <div class="poster-header-meta">
        <span class="meta-left">{{ section.settings.meta_left }}</span>
        {% comment %} <span class="meta-right">{{ section.settings.meta_right }}</span> {% endcomment %}
      </div>
      
      {% if section.settings.title != blank %}
        <h1 class="poster-main-title poster-title-top">
          {{ section.settings.title }}
        </h1>
      {% endif %}
    </div>
  </div>

  <!-- Bottom Split Block -->
  <div class="poster-bottom-half">
    <div class="poster-container">
      <!-- Right Aligned Content Container -->
      <div class="poster-content-wrapper">
        {% if section.settings.subtext != blank %}
          <div class="poster-subtext">
            {{ section.settings.subtext }}
          </div>
        {% endif %}
      </div>
    </div>

    <!-- Bottom Left Watermark / Favicon -->
    {% if section.settings.watermark_image != blank %}
      <div class="poster-watermark" style="opacity: {{ section.settings.watermark_opacity }};">
        <img 
          src="{{ section.settings.watermark_image | image_url: width: 400 }}" 
          alt="{{ section.settings.watermark_image.alt | default: 'Watermark' }}"
          loading="lazy"
          width="auto"
          height="auto"
        >
      </div>
    {% endif %}
  </div>
</div>

<style>
  .section-{{ section.id }} {
    position: relative;
    width: 100%;
    overflow: hidden;
    font-family: inherit;
  }

  .hero-poster-section .poster-container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 24px;
    position: relative;
    z-index: 2;
  }

  /* Top Section Styling */
  .hero-poster-section .poster-top-half {
    background-color: var(--bg-top);
    color: var(--text-top);
    padding-top: 100px;
    padding-bottom: 0px;
    position: relative;
  }

  .hero-poster-section .poster-header-meta {
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-size: 11px;
    letter-spacing: 2px;
    text-transform: uppercase;
    margin-bottom: 35px;
    opacity: 0.85;
    font-family: "League Spartan", sans-serif;
  }

  .hero-poster-section .poster-main-title {
    font-size: clamp(2.8rem, 7.5vw, 100px);
    font-weight: 800;
    line-height: 0.95;
    text-transform: uppercase;
    letter-spacing: -1px;
    margin-bottom: -25px;
    word-break: break-word;
    font-family: "League Spartan", sans-serif;
    opacity: 0;
    transform: translateY(50px);
    will-change: opacity, transform;
  }

  .hero-poster-section .poster-title-top {
    color: var(--text-top);
  }

  /* Bottom Section Styling */
  .hero-poster-section .poster-bottom-half {
    background-color: var(--bg-bottom);
    color: var(--text-bottom);
    padding-top: 80px;
    padding-bottom: 80px;
    position: relative;
    min-height: 380px;
  }

  /* Modified: Content Shifted to RIGHT Side */
  .hero-poster-section .poster-content-wrapper {
    max-width: 580px;
    margin-left: auto; /* Content ko Right side push karne ke liye */
    margin-right: 0;
  }

  .hero-poster-section .poster-subtext {
    font-size: clamp(1rem, 1.4vw, 18px);
    line-height: 1.6;
    color: var(--subtext-color);
    font-weight: 400;
    font-family: "League Spartan", sans-serif;
  }

  /* Watermark Image (Bottom-Left) */
  .hero-poster-section .poster-watermark {
    position: absolute;
    bottom: 1px;
    left: -20px;
    width: 300px;
    max-width: 35vw;
    z-index: 1;
    pointer-events: none;
        transform: rotate(180deg);
  }

  .hero-poster-section .poster-watermark img {
    width: 100%;
    height: auto;
    display: block;
  }

  /* Responsive Mobile View */
  @media screen and (max-width: 768px) {
    .hero-poster-section .poster-top-half {
      padding-top: 30px;
    }
    .hero-poster-section .poster-header-meta {
      margin-bottom: 30px;
      font-size: 10px;
    }
    .hero-poster-section .poster-bottom-half {
      padding-top: 30px;
      padding-bottom: 60px;
    }
    .hero-poster-section .poster-content-wrapper {
      margin-left: 0; /* Mobile me normal fit rakhne ke liye */
      max-width: 100%;
    }
    .hero-poster-section .poster-watermark {
      width: 160px;
    }
  }
</style>

<script>
  function initScrollAnim_{{ section.id | replace: '-', '_' | replace: ':', '_' }}() {
    const section = document.querySelector('.section-{{ section.id }}');
    if (!section) return;
    
    const titles = section.querySelectorAll('.poster-main-title');
    if (titles.length === 0) return;

    function handleScroll() {
      const rect = section.getBoundingClientRect();
      const windowHeight = window.innerHeight || document.documentElement.clientHeight;
      
      const visiblePx = windowHeight - rect.top;
      
      const startPx = 0; 
      const endPx = windowHeight * 0.5; 
      
      let progress = 0;
      if (visiblePx > startPx) {
        progress = (visiblePx - startPx) / (endPx - startPx);
      }
      
      progress = Math.max(0, Math.min(1, progress));
      
      titles.forEach(title => {
        title.style.opacity = progress;
        title.style.transform = `translateY(${50 * (1 - progress)}px)`;
      });
    }

    window.addEventListener('scroll', handleScroll, { passive: true });
    document.addEventListener('scroll', handleScroll, { passive: true, capture: true });
    
    handleScroll();
  }
  
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initScrollAnim_{{ section.id | replace: '-', '_' | replace: ':', '_' }});
  } else {
    initScrollAnim_{{ section.id | replace: '-', '_' | replace: ':', '_' }}();
  }
</script>

{% schema %}
{
  "name": "Poster Hero Section",
  "tag": "section",
  "class": "section-poster-hero",
  "settings": [
    {
      "type": "header",
      "content": "Content Settings"
    },
    {
      "type": "text",
      "id": "meta_left",
      "label": "Header Meta Left",
      "default": "CONCEPT POSTER SERIES"
    },
    {
      "type": "text",
      "id": "meta_right",
      "label": "Header Meta Right",
      "default": "2025 // DESIGN NO. 45"
    },
    {
      "type": "textarea",
      "id": "title",
      "label": "Main Title",
      "default": "Because You Shouldn’t Have To Settle"
    },
    {
      "type": "richtext",
      "id": "subtext",
      "label": "Sub Text",
      "default": "<p>We Men are very selective about cars, phones, and watches, yet some essentials are often left as afterthoughts.<br><br>We’re here to change that.<br>WeMen brings you well-made everyday pieces that feel good to own and even better to use.</p>"
    },
    {
      "type": "header",
      "content": "Watermark / Favicon Image Settings"
    },
    {
      "type": "image_picker",
      "id": "watermark_image",
      "label": "Bottom Left Watermark / Favicon Image"
    },
    {
      "type": "range",
      "id": "watermark_opacity",
      "min": 0.1,
      "max": 1,
      "step": 0.1,
      "label": "Watermark Opacity",
      "default": 0.5
    },
    {
      "type": "header",
      "content": "Color Customization"
    },
    {
      "type": "color",
      "id": "bg_color_top",
      "label": "Top Background Color",
      "default": "#481118"
    },
    {
      "type": "color",
      "id": "bg_color_bottom",
      "label": "Bottom Background Color",
      "default": "#F5EAD0"
    },
    {
      "type": "color",
      "id": "text_color_top",
      "label": "Top Title/Text Color",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "text_color_bottom",
      "label": "Bottom Title Color",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "subtext_color",
      "label": "Subtext Color",
      "default": "#000000"
    }
  ],
  "presets": [
    {
      "name": "Poster Hero Section",
      "category": "Image & Text"
    }
  ]
}
{% endschema %}