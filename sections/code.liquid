{%- comment -%}
  Custom Scroll-driven 3D Model Section with RESTORED ORIGINAL ANIMATION
{%- endcomment -%}

<script type="module" src="https://ajax.googleapis.com/ajax/libs/model-viewer/3.1.1/model-viewer.min.js"></script>

<div class="sf-3d-wrapper" id="sf-3d-section-{{ section.id }}">
  {%- if section.settings.model_url != blank -%}
    <model-viewer
      class="sf-3d-viewer"
      alt="{{ section.settings.alt_text | escape }}"
      src="{{ section.settings.model_url }}"
      loading="eager"
      disable-zoom
    ></model-viewer>
  {%- else -%}
    <div class="sf-3d-placeholder">
      <p>Please add a 3D Model GLB URL in the section settings.</p>
    </div>
  {%- endif -%}
</div>

<style>
  /* Base wrapper for page flow */
  .sf-3d-wrapper {
    position: relative;
    width: 100%;
    height: 100vh; /* Base height for the section */
    overflow: visible; /* Important for the fixed positioning to work with scroll */
  }

  /* Original CSS Animation restored */
  @keyframes sf-original-foo {
    to {
      scale: 1; /* Original target scale from your code */
    }
  }

  /* Restored original model-viewer styling & animation logic */
  .sf-3d-viewer {
    display: block;
    width: 100%;
    height: 95vh; /* Original height from your code */
    position: fixed; /* Original fixed positioning */
    z-index: -1; /* Original z-index */
    pointer-events: none; /* Helpful for scrolling on top of the model */
    
    /* Applying original animation and scroll timeline */
    animation: sf-original-foo linear both;
    animation-timeline: scroll(block root);
  }

  /* Keep original behavior - no default bar */
  .sf-3d-viewer::part(default-progress-bar) {
    display: none;
  }

  /* Fallback and loading state */
  .sf-3d-placeholder {
    display: flex;
    align-items: center;
    justify-content: center;
    height: 300px;
    border: 2px dashed #ccc;
    background: #f9f9f9;
    text-align: center;
    padding: 20px;
  }

  /* Basic responsiveness while trying to preserve fixed behavior */
  @media screen and (max-width: 767px) {
    .sf-3d-viewer {
      height: 70vh; /* Slightly smaller on mobile to preserve performance */
    }
  }
</style>

<script>
  // Dynamic import of original dependency used in your script
  const sdaUtilUrl = "https://esm.sh/@bramus/sda-utilities";

  document.addEventListener("DOMContentLoaded", function() {
    // Unique ID used to scope query selectors, maintaining original logic
    const model = document.querySelector("#sf-3d-section-{{ section.id }} .sf-3d-viewer");
    if (!model) return;

    // Check animations logic from original script
    const modelAnimations = model.getAnimations();
    if (!modelAnimations || modelAnimations.length === 0) return;
    const coreAnimation = modelAnimations[0];

    // RESTORED: Original complex JavaScript logic for driving rotation
    // Try using the new Animation.overallProgress if available
    if (("Animation" in self && "overallProgress" in Animation.prototype)) {
        document.addEventListener('scroll', (e) => {
            const progress = coreAnimation.overallProgress;
            // Original orientation calculation
            model.orientation = `0deg 0deg ${progress * -360}deg`;
        });
    } else {
        // RESTORED: Original dynamic dependency loading and polyfill use
        import(sdaUtilUrl)
            .then((module) => {
                const trackProgress = module.trackProgress;
                trackProgress(coreAnimation, (progress) => {
                    // Original orientation calculation
                    model.orientation = `0deg 0deg ${progress * -360}deg`;
                });
            })
            .catch(err => console.error("Failed to load original sda-utilities dependency:", err));
    }
  });
</script>

{% schema %}
{
  "name": "Scroll 3D Model Anim",
  "tag": "section",
  "class": "shopify-section-3d-scroll-anim",
  "settings": [
    {
      "type": "text",
      "id": "model_url",
      "label": "3D Model GLB URL",
      "default": "https://assets.codepen.io/89905/nike_air_max_90.glb",
      "info": "Upload your .glb file to Shopify (Content > Files) and copy the link here."
    },
    {
      "type": "text",
      "id": "alt_text",
      "label": "Model Alt Text",
      "default": "3D Animated Shoe Model"
    }
  ],
  "presets": [
    {
      "name": "Scroll 3D Model Anim"
    }
  ]
}
{% endschema %}