{% comment %}
  Shop ke footer ke liye 3-column contact block.
  Sab kuch section settings se dynamic hai aur mobile par stack ho jata hai.
{% endcomment %}

<style>
  .bs-footer-wrap {
    width: 100%;
    background: {{ section.settings.bg_color }};
    padding: {{ section.settings.padding_top }}px {{ section.settings.padding_side }}px {{ section.settings.padding_bottom }}px;
    box-sizing: border-box;
    font-family: {{ section.settings.font_family }};
  }

  .bs-footer-grid {
    max-width: {{ section.settings.container_width }}px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
  }

  .bs-footer-col {
    padding: 10px {{ section.settings.column_gap | divided_by: 2.0 }}px;
    border-right: 1px solid {{ section.settings.divider_color }};
    display: flex;
    flex-direction: column;
    align-items: flex-start;
  }

  .bs-footer-col:first-child {
    padding-left: 0;
  }

  .bs-footer-col:last-child {
    padding-right: 0;
    border-right: none;
  }

  .bs-footer-title {
    font-size: {{ section.settings.title_size }}px;
    font-weight: {{ section.settings.title_weight }};
    color: {{ section.settings.title_color }};
    margin: 0 0 18px;
    line-height: 1.3;
  }

  .bs-footer-line,
  .bs-footer-link {
    display: block;
    font-size: {{ section.settings.text_size }}px;
    font-weight: {{ section.settings.text_weight }};
    color: {{ section.settings.text_color }};
    line-height: 1.7;
    text-decoration: none;
    margin: 0 0 6px;
    word-break: break-word;
  }

  .bs-footer-link {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .bs-footer-link:hover {
    color: {{ section.settings.title_color }};
  }

  .bs-footer-link svg {
    width: 14px;
    height: 14px;
    flex-shrink: 0;
  }

  .bs-footer-email-wrap {
    margin: 0 0 6px;
    font-size: {{ section.settings.text_size }}px;
    font-weight: {{ section.settings.text_weight }};
    color: {{ section.settings.text_color }};
    line-height: 1.7;
  }

  .bs-footer-email-wrap .bs-footer-link {
    font-size: {{ section.settings.text_size }}px;
  }

  /* Tablet & Mobile */
  @media screen and (max-width: 749px) {
    .bs-footer-grid {
      grid-template-columns: 1fr;
    }
    .bs-footer-col {
      padding: 18px 0;
      border-right: none;
      border-bottom: 1px solid {{ section.settings.divider_color }};
    }
    .bs-footer-col:first-child {
      padding-top: 0;
    }
    .bs-footer-col:last-child {
      padding-bottom: 0;
      border-bottom: none;
    }
    .bs-footer-title {
      font-size: {{ section.settings.title_size | minus: 2 }}px;
      margin-bottom: 12px;
    }
    .bs-footer-line,
    .bs-footer-link,
    .bs-footer-email-wrap {
      font-size: {{ section.settings.text_size | at_least: 15 }}px;
    }
  }
</style>

<div class="bs-footer-wrap">
  <div class="bs-footer-grid">

    {% comment %} Column 1 : Contact Details {% endcomment %}
    <div class="bs-footer-col">
      <h3 class="bs-footer-title">{{ section.settings.contact_title }}</h3>

      {% if section.settings.phone != blank %}
        <a class="bs-footer-link" href="tel:{{ section.settings.phone | remove: ' ' | remove: '+' }}">
          {{ section.settings.phone }}
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/>
            <polyline points="15 3 21 3 21 9"/>
            <line x1="10" y1="14" x2="21" y2="3"/>
          </svg>
        </a>
      {% endif %}

      {% if section.settings.whatsapp != blank %}
        <a class="bs-footer-link"
           href="https://wa.me/{{ section.settings.whatsapp | remove: ' ' | remove: '+' }}"
           target="_blank" rel="noopener">
          {{ section.settings.whatsapp_label }}
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/>
            <polyline points="15 3 21 3 21 9"/>
            <line x1="10" y1="14" x2="21" y2="3"/>
          </svg>
        </a>
      {% endif %}

      {% if section.settings.email != blank %}
        <a class="bs-footer-link" href="mailto:{{ section.settings.email }}">
          {{ section.settings.email }}
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/>
            <polyline points="15 3 21 3 21 9"/>
            <line x1="10" y1="14" x2="21" y2="3"/>
          </svg>
        </a>
      {% endif %}
    </div>

    {% comment %} Column 2 : Registered Office {% endcomment %}
    <div class="bs-footer-col">
      <h3 class="bs-footer-title">{{ section.settings.office_title }}</h3>

      {% if section.settings.company_name != blank %}
        <p class="bs-footer-line">{{ section.settings.company_name }}</p>
      {% endif %}
      {% if section.settings.cin != blank %}
        <p class="bs-footer-line">CIN:- {{ section.settings.cin }}</p>
      {% endif %}
      {% if section.settings.address != blank %}
        <p class="bs-footer-line">{{ section.settings.address }}</p>
      {% endif %}
    </div>

    {% comment %} Column 3 : Grievance / Nodal / CERT-IN {% endcomment %}
    <div class="bs-footer-col">
      <h3 class="bs-footer-title">{{ section.settings.grievance_title }}</h3>

      {% if section.settings.officer_names != blank %}
        <p class="bs-footer-line">{{ section.settings.officer_names }}</p>
      {% endif %}

      {% if section.settings.grievance_email != blank %}
        <p class="bs-footer-email-wrap">
          Email ID:
          <a class="bs-footer-link" href="mailto:{{ section.settings.grievance_email }}">
            {{ section.settings.grievance_email }}
          </a>
        </p>
      {% endif %}

      {% if section.settings.grievance_phone != blank %}
        <p class="bs-footer-line">Contact No: {{ section.settings.grievance_phone }}</p>
      {% endif %}

      {% if section.settings.grievance_time != blank %}
        <p class="bs-footer-line">Time: {{ section.settings.grievance_time }}</p>
      {% endif %}
    </div>

  </div>
</div>

{% schema %}
{
  "name": "Footer Contact Block",
  "tag": "section",
  "class": "section-footer-contact",
  "settings": [
    {
      "type": "header",
      "content": "Contact Details"
    },
    { "type": "text", "id": "contact_title", "label": "Heading", "default": "Contact Details" },
    { "type": "text", "id": "phone", "label": "Phone number", "default": "+91 9513446201" },
    { "type": "text", "id": "whatsapp_label", "label": "WhatsApp label", "default": "WHATSAPP" },
    { "type": "text", "id": "whatsapp", "label": "WhatsApp number (with country code)", "default": "+919513446201", "info": "Sirf number, koi sign nahi. jaise +919513446201" },
    { "type": "text", "id": "email", "label": "Support email", "default": "support@bombayshirts.com" },

    {
      "type": "header",
      "content": "Registered Office"
    },
    { "type": "text", "id": "office_title", "label": "Heading", "default": "Registered Office" },
    { "type": "text", "id": "company_name", "label": "Company name", "default": "Tomorrowland Apparels Pvt Ltd" },
    { "type": "text", "id": "cin", "label": "CIN", "default": "U18109MH2014PTC253178" },
    { "type": "textarea", "id": "address", "label": "Address", "default": "101 A, Marathon Chambers,\nN. M. Joshi Marg, Lower Parel (East), Mumbai - 400013." },

    {
      "type": "header",
      "content": "Grievance / Nodal / CERT-IN"
    },
    { "type": "text", "id": "grievance_title", "label": "Heading", "default": "Grievance/Nodal Officer/CERT-IN Officer" },
    { "type": "text", "id": "officer_names", "label": "Officer names", "default": "Mr. Arokia Martin Nadar / Ms. Uzma Ansari" },
    { "type": "text", "id": "grievance_email", "label": "Email ID", "default": "grievances@bombayshirts.com" },
    { "type": "text", "id": "grievance_phone", "label": "Contact number", "default": "+91 9439780974" },
    { "type": "text", "id": "grievance_time", "label": "Timing", "default": "10.00am to 6.00pm (Monday to Saturday)" },

    {
      "type": "header",
      "content": "Layout & Styling"
    },
    { "type": "color", "id": "bg_color", "label": "Background color", "default": "#ffffff" },
    { "type": "color", "id": "title_color", "label": "Heading color", "default": "#111111" },
    { "type": "color", "id": "text_color", "label": "Text color", "default": "#666666" },
    { "type": "text", "id": "font_family", "label": "Font family", "default": "-apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif" },
    { "type": "range", "id": "title_size", "label": "Heading size (px)", "min": 16, "max": 36, "step": 1, "default": 22 },
    { "type": "select", "id": "title_weight", "label": "Heading weight", "options": [
        { "value": "400", "label": "Normal" },
        { "value": "500", "label": "Medium" },
        { "value": "600", "label": "Semibold" },
        { "value": "700", "label": "Bold" }
      ], "default": "500"
    },
    { "type": "range", "id": "text_size", "label": "Text size (px)", "min": 13, "max": 22, "step": 1, "default": 16 },
    { "type": "select", "id": "text_weight", "label": "Text weight", "options": [
        { "value": "400", "label": "Normal" },
        { "value": "500", "label": "Medium" }
      ], "default": "400"
    },
    { "type": "range", "id": "container_width", "label": "Container max width (px)", "min": 800, "max": 1600, "step": 20, "default": 1600 },
    { "type": "range", "id": "column_gap", "label": "Column spacing (px)", "min": 20, "max": 120, "step": 5, "default": 60 },
    { "type": "color", "id": "divider_color", "label": "Divider line color", "default": "#e5e5e5" },
    { "type": "range", "id": "padding_top", "label": "Top padding (px)", "min": 0, "max": 120, "step": 5, "default": 60 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom padding (px)", "min": 0, "max": 120, "step": 5, "default": 60 },
    { "type": "range", "id": "padding_side", "label": "Side padding (px)", "min": 10, "max": 80, "step": 5, "default": 30 }
  ],
  "presets": [
    {
      "name": "Footer Contact Block"
    }
  ]
}
{% endschema %}
