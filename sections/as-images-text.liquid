{{ 'section-personalised-service.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign s = section.settings
  assign uid = section.id
-%}

{%- style -%}
  #PersonalisedService--{{ uid }} {
    --ps-bg: {{ s.bg_color }};
    --ps-title-color: {{ s.title_color }};
    --ps-heading-color: {{ s.heading_color }};
    --ps-text-color: {{ s.text_color }};
    --ps-link-color: {{ s.link_color }};
    --ps-offset: {{ s.left_offset }}%;
    --ps-gap: {{ s.column_gap }}px;
    --ps-media-radius: {{ s.media_radius }}px;
    --ps-media-ratio: {{ s.media_ratio }};
    --ps-title-size: {{ s.title_size }}px;
    --ps-heading-size: {{ s.heading_size }}px;
    --ps-text-size: {{ s.text_size }}px;
    --ps-pt: {{ s.padding_top }}px;
    --ps-pb: {{ s.padding_bottom }}px;
    --ps-pt-m: {{ s.padding_top | times: 0.6 | round }}px;
    --ps-pb-m: {{ s.padding_bottom | times: 0.6 | round }}px;
    --ps-edge: {{ s.page_edge }}px;
  }
  {%- if s.full_bleed_right == false -%}
    #PersonalisedService--{{ uid }} .ps__inner { max-width: {{ s.max_width }}px; margin-inline: auto; }
  {%- endif -%}
{%- endstyle -%}

<section
  id="PersonalisedService--{{ uid }}"
  class="ps-section{% if s.full_bleed_right %} ps-section--bleed{% endif %}"
  data-section-id="{{ uid }}"
  data-section-type="personalised-service"
>
  <div class="ps__inner">

    {%- comment -%} ============ MEDIA ============ {%- endcomment -%}
    {%- if s.show_media -%}
      <div class="ps__media-row">
        <div class="ps__media reveal" style="--ps-ratio: {{ s.media_ratio }};">
          {%- if s.video != blank -%}
            {{
              s.video
              | video_tag:
                image_size: '1600x',
                autoplay: s.video_autoplay,
                loop: s.video_loop,
                muted: true,
                controls: s.video_controls,
                playsinline: true,
                class: 'ps__media-el'
            }}

          {%- elsif s.video_url != blank -%}
            {%- if s.video_url.type == 'youtube' -%}
              <iframe
                class="ps__media-el"
                src="https://www.youtube.com/embed/{{ s.video_url.id }}?autoplay={% if s.video_autoplay %}1{% else %}0{% endif %}&mute=1&loop={% if s.video_loop %}1{% else %}0{% endif %}&playlist={{ s.video_url.id }}&controls={% if s.video_controls %}1{% else %}0{% endif %}&rel=0&playsinline=1"
                title="{{ s.title | escape }}"
                allow="autoplay; encrypted-media; picture-in-picture"
                allowfullscreen
                loading="lazy"
              ></iframe>
            {%- else -%}
              <iframe
                class="ps__media-el"
                src="https://player.vimeo.com/video/{{ s.video_url.id }}?autoplay={% if s.video_autoplay %}1{% else %}0{% endif %}&muted=1&loop={% if s.video_loop %}1{% else %}0{% endif %}&background={% unless s.video_controls %}1{% endunless %}"
                title="{{ s.title | escape }}"
                allow="autoplay; fullscreen; picture-in-picture"
                allowfullscreen
                loading="lazy"
              ></iframe>
            {%- endif -%}

          {%- elsif s.image != blank -%}
            {{
              s.image
              | image_url: width: 1800
              | image_tag:
                loading: 'lazy',
                class: 'ps__media-el',
                sizes: '(max-width: 749px) 100vw, 75vw',
                widths: '400,600,800,1000,1200,1500,1800',
                alt: s.image.alt | default: s.title
            }}

          {%- else -%}
            {{ 'lifestyle-1' | placeholder_svg_tag: 'ps__media-el ps__placeholder' }}
          {%- endif -%}
        </div>
      </div>
    {%- endif -%}

    {%- comment -%} ============ CONTENT ============ {%- endcomment -%}
    <div class="ps__content">

      {%- comment -%} LEFT COLUMN {%- endcomment -%}
      <div class="ps__col ps__col--left reveal">
        {%- if s.title != blank -%}
          <h2 class="ps__title">{{ s.title }}</h2>
        {%- endif -%}

        {%- if s.link_label != blank -%}
          <div class="ps__link-wrap">
            <a
              class="ps__link"
              href="{{ s.link_url | default: '#' }}"
              {% if s.link_new_tab %}
                target="_blank"
                rel="noopener"
              {% endif %}
            >
              <span class="ps__link-text">{{ s.link_label }}</span>
              <span class="ps__link-arrow" aria-hidden="true">
                <svg viewBox="0 0 14 14" fill="none" xmlns="http://www.w3.org/2000/svg">
                  <path d="M2.5 11.5L11.5 2.5M11.5 2.5H4.5M11.5 2.5V9.5" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
              </span>
            </a>
          </div>
        {%- endif -%}
      </div>

      {%- comment -%} RIGHT COLUMN {%- endcomment -%}
      <div class="ps__col ps__col--right reveal">
        {%- if s.heading != blank -%}
          <h3 class="ps__heading">{{ s.heading }}</h3>
        {%- endif -%}

        {%- if s.text != blank -%}
          <div class="ps__text rte">{{ s.text }}</div>
        {%- endif -%}

        {%- if s.button_label != blank -%}
          <a
            class="ps__button"
            href="{{ s.button_url | default: '#' }}"
            {% if s.button_new_tab %}
              target="_blank"
              rel="noopener"
            {% endif %}
          >
            {{ s.button_label }}
          </a>
        {%- endif -%}
      </div>

    </div>
  </div>
</section>

<script>
  (function () {
    var root = document.getElementById('PersonalisedService--{{ uid }}');
    if (!root) return;

    var items = root.querySelectorAll('.reveal');
    if (!('IntersectionObserver' in window)) {
      root.classList.add('no-js');
      return;
    }

    var io = new IntersectionObserver(
      function (entries) {
        entries.forEach(function (entry) {
          if (entry.isIntersecting) {
            entry.target.classList.add('is-visible');
            io.unobserve(entry.target);
          }
        });
      },
      { threshold: 0.12, rootMargin: '0px 0px -8% 0px' }
    );

    items.forEach(function (el) {
      io.observe(el);
    });

    // Theme editor: show instantly
    document.addEventListener('shopify:section:load', function (e) {
      if (e.detail.sectionId === '{{ uid }}') {
        root.querySelectorAll('.reveal').forEach(function (el) {
          el.classList.add('is-visible');
        });
      }
    });
  })();
</script>

{% schema %}
{
  "name": "Personalised Service",
  "tag": "section",
  "class": "section-personalised-service",
  "settings": [
    {
      "type": "header",
      "content": "Media"
    },
    {
      "type": "checkbox",
      "id": "show_media",
      "label": "Show media",
      "default": true
    },
    {
      "type": "video",
      "id": "video",
      "label": "Video (uploaded)",
      "info": "Priority 1. Leave empty to use a video URL or image."
    },
    {
      "type": "video_url",
      "id": "video_url",
      "label": "Video link (YouTube / Vimeo)",
      "accept": ["youtube", "vimeo"],
      "info": "Priority 2."
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image",
      "info": "Priority 3 — used when no video is set."
    },
    {
      "type": "checkbox",
      "id": "video_autoplay",
      "label": "Autoplay video",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "video_loop",
      "label": "Loop video",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "video_controls",
      "label": "Show video controls",
      "default": false
    },
    {
      "type": "select",
      "id": "media_ratio",
      "label": "Media aspect ratio",
      "options": [
        { "value": "21/9", "label": "21:9 (ultra wide)" },
        { "value": "2.4/1", "label": "2.4:1 (cinematic)" },
        { "value": "16/9", "label": "16:9" },
        { "value": "4/3", "label": "4:3" },
        { "value": "1/1", "label": "1:1" }
      ],
      "default": "2.4/1"
    },
    {
      "type": "range",
      "id": "media_radius",
      "label": "Media corner radius",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "default": 0
    },
    {
      "type": "header",
      "content": "Left column"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Title",
      "default": "Personalised Service"
    },
    {
      "type": "range",
      "id": "title_size",
      "label": "Title size (desktop)",
      "min": 24,
      "max": 96,
      "step": 2,
      "unit": "px",
      "default": 54
    },
    {
      "type": "text",
      "id": "link_label",
      "label": "Link label",
      "default": "CHAT WITH US"
    },
    {
      "type": "url",
      "id": "link_url",
      "label": "Link URL"
    },
    {
      "type": "checkbox",
      "id": "link_new_tab",
      "label": "Open link in new tab",
      "default": false
    },
    {
      "type": "header",
      "content": "Right column"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Getting your clothes tailored with us is enjoyable, intuitive and easy."
    },
    {
      "type": "range",
      "id": "heading_size",
      "label": "Heading size (desktop)",
      "min": 18,
      "max": 64,
      "step": 1,
      "unit": "px",
      "default": 34
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Description",
      "default": "<p>Be it styling help, suggestions about customisations or any other questions you may have, you can get in touch with us anytime.</p>"
    },
    {
      "type": "range",
      "id": "text_size",
      "label": "Description size",
      "min": 12,
      "max": 24,
      "step": 1,
      "unit": "px",
      "default": 15
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label (optional)"
    },
    {
      "type": "url",
      "id": "button_url",
      "label": "Button URL"
    },
    {
      "type": "checkbox",
      "id": "button_new_tab",
      "label": "Open button in new tab",
      "default": false
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "checkbox",
      "id": "full_bleed_right",
      "label": "Full bleed to right edge",
      "default": true
    },
    {
      "type": "range",
      "id": "left_offset",
      "label": "Left offset",
      "min": 0,
      "max": 45,
      "step": 1,
      "unit": "%",
      "default": 27
    },
    {
      "type": "range",
      "id": "max_width",
      "label": "Max width (when not full bleed)",
      "min": 900,
      "max": 1800,
      "step": 20,
      "unit": "px",
      "default": 1400
    },
    {
      "type": "range",
      "id": "page_edge",
      "label": "Right / mobile edge padding",
      "min": 0,
      "max": 80,
      "step": 2,
      "unit": "px",
      "default": 20
    },
    {
      "type": "range",
      "id": "column_gap",
      "label": "Column gap",
      "min": 16,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 60
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding top",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 60
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding bottom",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 80
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background",
      "default": "#FDFBF6"
    },
    {
      "type": "color",
      "id": "title_color",
      "label": "Title color",
      "default": "#9B9B98"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading color",
      "default": "#1A1A1A"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Description color",
      "default": "#5C5C5C"
    },
    {
      "type": "color",
      "id": "link_color",
      "label": "Link color",
      "default": "#1A1A1A"
    }
  ],
  "presets": [
    {
      "name": "Personalised Service"
    }
  ]
}
{% endschema %}
