{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
    background-color: {{ section.settings.bg_color }};
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }

  .rich-text-wrapper-{{ section.id }} {
    max-width: {{ section.settings.content_width }}px;
    margin: 0 auto;
    padding: 0 20px;
    text-align: {{ section.settings.text_alignment }};
    box-sizing: border-box;
  }

  .rich-text-subtitle-{{ section.id }} {
    font-size: {{ section.settings.subtitle_size_mobile }}px;
    color: {{ section.settings.subtitle_color }};
    margin-bottom: 10px;
    text-transform: uppercase;
    letter-spacing: 1px;
    font-weight: 600;
  }

  .rich-text-title-{{ section.id }} {
    font-size: {{ section.settings.title_size_mobile }}px;
    color: {{ section.settings.title_color }};
    margin-top: 0;
    margin-bottom: 5px;
    line-height: 1.2;
    font-weight: 700;
    text-transform: uppercase;
  }

  .rich-text-body-{{ section.id }} {
    font-size: {{ section.settings.body_size_mobile }}px;
    color: {{ section.settings.body_color }};
    margin-bottom: 25px;
    line-height: 1.2;
  }

  .rich-text-btn-{{ section.id }} {
    display: inline-block;
    padding: 12px 30px;
    font-size: 16px;
    text-decoration: none;
    border-radius: {{ section.settings.btn_border_radius }}px;
    background-color: {{ section.settings.btn_bg_color }};
    color: {{ section.settings.btn_text_color }};
    border: 1px solid {{ section.settings.btn_border_color }};
    transition: all 0.3s ease;
  }

  .rich-text-btn-{{ section.id }}:hover {
    background-color: {{ section.settings.btn_hover_bg_color }};
    color: {{ section.settings.btn_hover_text_color }};
  }

  /* Desktop Responsive Styles */
  @media screen and (min-width: 750px) {
    .rich-text-subtitle-{{ section.id }} {
      font-size: {{ section.settings.subtitle_size_desktop }}px;
    }
    .rich-text-title-{{ section.id }} {
      font-size: {{ section.settings.title_size_desktop }}px;
    }
    .rich-text-body-{{ section.id }} {
      font-size: {{ section.settings.body_size_desktop }}px;
    }
  }
  .as-mb-30{
    margin-bottom: -40px;
  }
{%- endstyle -%}

<div class="section-{{ section.id }}-padding as-mb-30">
  <div class="rich-text-wrapper-{{ section.id }}">
    
    {%- if section.settings.subtitle != blank -%}
      <div class="rich-text-subtitle-{{ section.id }}">
        {{ section.settings.subtitle }}
      </div>
    {%- endif -%}

    {%- if section.settings.title != blank -%}
      <h2 class="rich-text-title-{{ section.id }}">
        {{ section.settings.title }}
      </h2>
    {%- endif -%}

    {%- if section.settings.body_text != blank -%}
      <div class="rich-text-body-{{ section.id }}">
        {{ section.settings.body_text }}
      </div>
    {%- endif -%}

    {%- if section.settings.btn_label != blank and section.settings.btn_link != blank -%}
      <a href="{{ section.settings.btn_link }}" class="rich-text-btn-{{ section.id }}">
        {{ section.settings.btn_label }}
      </a>
    {%- endif -%}

  </div>
</div>

{% schema %}
{
  "name": "Custom Rich Text",
  "settings": [
    {
      "type": "header",
      "content": "Layout Settings"
    },
    {
      "type": "select",
      "id": "text_alignment",
      "label": "Text Alignment",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "right", "label": "Right" }
      ],
      "default": "center"
    },
    {
      "type": "range",
      "id": "content_width",
      "min": 400,
      "max": 1200,
      "step": 20,
      "unit": "px",
      "label": "Max Content Width",
      "default": 800
    },
    {
      "type": "header",
      "content": "Subtitle Settings"
    },
    {
      "type": "text",
      "id": "subtitle",
      "label": "Subtitle",
      "default": "WELCOME TO OUR STORE"
    },
    {
      "type": "color",
      "id": "subtitle_color",
      "label": "Subtitle Color",
      "default": "#666666"
    },
    {
      "type": "range",
      "id": "subtitle_size_desktop",
      "min": 10,
      "max": 30,
      "step": 1,
      "unit": "px",
      "label": "Subtitle Size (Desktop)",
      "default": 14
    },
    {
      "type": "range",
      "id": "subtitle_size_mobile",
      "min": 10,
      "max": 24,
      "step": 1,
      "unit": "px",
      "label": "Subtitle Size (Mobile)",
      "default": 12
    },
    {
      "type": "header",
      "content": "Title Settings"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Title",
      "default": "Crafted For Quality & Comfort"
    },
    {
      "type": "color",
      "id": "title_color",
      "label": "Title Color",
      "default": "#121212"
    },
    {
      "type": "range",
      "id": "title_size_desktop",
      "min": 20,
      "max": 80,
      "step": 2,
      "unit": "px",
      "label": "Title Size (Desktop)",
      "default": 40
    },
    {
      "type": "range",
      "id": "title_size_mobile",
      "min": 18,
      "max": 50,
      "step": 1,
      "unit": "px",
      "label": "Title Size (Mobile)",
      "default": 28
    },
    {
      "type": "header",
      "content": "Body Text Settings"
    },
    {
      "type": "richtext",
      "id": "body_text",
      "label": "Body Text",
      "default": "<p>Share information about your brand with your customers. Describe a product, make announcements, or welcome customers to your store.</p>"
    },
    {
      "type": "color",
      "id": "body_color",
      "label": "Body Text Color",
      "default": "#333333"
    },
    {
      "type": "range",
      "id": "body_size_desktop",
      "min": 12,
      "max": 28,
      "step": 1,
      "unit": "px",
      "label": "Body Size (Desktop)",
      "default": 16
    },
    {
      "type": "range",
      "id": "body_size_mobile",
      "min": 12,
      "max": 22,
      "step": 1,
      "unit": "px",
      "label": "Body Size (Mobile)",
      "default": 14
    },
    {
      "type": "header",
      "content": "Button Settings"
    },
    {
      "type": "text",
      "id": "btn_label",
      "label": "Button Label",
      "default": "Shop Now"
    },
    {
      "type": "url",
      "id": "btn_link",
      "label": "Button Link"
    },
    {
      "type": "color",
      "id": "btn_bg_color",
      "label": "Button Background",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "btn_text_color",
      "label": "Button Text Color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "btn_border_color",
      "label": "Button Border Color",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "btn_hover_bg_color",
      "label": "Hover Background",
      "default": "#333333"
    },
    {
      "type": "color",
      "id": "btn_hover_text_color",
      "label": "Hover Text Color",
      "default": "#ffffff"
    },
    {
      "type": "range",
      "id": "btn_border_radius",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "label": "Button Border Radius",
      "default": 4
    },
    {
      "type": "header",
      "content": "Section Spacing & Background"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Section Background Color",
      "default": "#ffffff"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Top Padding",
      "default": 60
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Bottom Padding",
      "default": 60
    }
  ],
  "presets": [
    {
      "name": "Custom Rich Text"
    }
  ]
}
{% endschema %}