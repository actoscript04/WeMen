{%- doc -%}
  Product media gallery content styles extracted into a standalone snippet.

  @example
  {% render 'product-media-gallery-content-styles' %}
{%- enddoc -%}

{% stylesheet %}
  media-gallery:where(.media-gallery--grid) .media-gallery__grid {
    display: none;
  }

  media-gallery.media-gallery--grid .media-gallery__grid .product-media-container {
    /* Needed for safari to stretch to full grid height */
    height: 100%;
  }

  @media screen and (min-width: 750px) {
    .media-gallery--two-column .media-gallery__grid {
      grid-template-columns: repeat(2, 1fr);
    }

    /* Display grid view as a carousel on mobile, grid on desktop */
    media-gallery:is(.media-gallery--grid) slideshow-component {
      display: none;
    }

    media-gallery:where(.media-gallery--grid) .media-gallery__grid {
      display: grid;
    }
  }

  zoom-dialog dialog {
    width: 100vw;
    height: 100vh;
    border: none;
    margin: 0;
    padding: 0;
    max-width: 100%;
    max-height: 100%;
    background: #fff;
    opacity: 0;
    transition: opacity var(--animation-speed) var(--animation-easing);
    scrollbar-width: none;

    &[open] {
      opacity: 1;
    }

    @media (prefers-reduced-motion: no-preference) {
      scroll-behavior: smooth;
    }

    &::backdrop {
      background: transparent;
    }
  }

  .product-media-container__zoom-button {
    position: absolute;
    width: 100%;
    height: 100%;
    z-index: var(--layer-flat);
    cursor: zoom-in;
    background-color: transparent;

    &:hover {
      background-color: transparent;
    }
  }

  slideshow-slide.product-media-container--tallest {
    content-visibility: visible;
  }

  .product-media__drag-zoom-wrapper {
    aspect-ratio: inherit;
    min-height: inherit;
    min-width: inherit;
    display: inherit;
    flex: inherit;
  }

  .media-gallery__mobile-controls {
    grid-area: auto;
  }

  .product-media-container--zoomable.product-media-container--image {
    cursor: zoom-in;
  }

  /* =============================================
     Split Sticky Gallery (Bluorng-style layout)
     Left image = sticky, Right images = scroll
     ============================================= */

  /* Hide the old grid on desktop when split-sticky is used */
  @media screen and (min-width: 750px) {
    media-gallery:is(.media-gallery--grid) .media-gallery__grid {
      display: none;
    }
  }

  /* Split Sticky Container */
  .media-gallery__split-sticky {
    display: none;
  }

  @media screen and (min-width: 750px) {
    .media-gallery__split-sticky {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: var(--image-gap, 4px);
      align-items: start;
    }

    /* Override parent sticky-content so child sticky works */
    media-gallery.sticky-content:has(.media-gallery__split-sticky) {
      position: relative;
    }
  }

  /* Left Column - Sticky FULL SCREEN (no top/bottom spacing) */
  @media screen and (min-width: 750px) {
    .media-gallery__split-sticky-left {
      position: sticky;
      /* Stick to the very top of the viewport - no top gap */
      top: 0;
      /* Fill the entire viewport height - no bottom gap */
      height: 100vh;
      align-self: start;
    }

    .media-gallery__split-sticky-left .product-media-container {
      width: 100%;
      /* Container fills the full-screen sticky column */
      height: 100%;
      max-height: none;
      aspect-ratio: auto;
      border-radius: var(--media-radius, 0px);
      overflow: hidden;
      margin: 0 !important;
      background: transparent !important;
    }

    /* Inner wrappers must also fill the full screen height */
    .media-gallery__split-sticky-left .product-media,
    .media-gallery__split-sticky-left .product-media-constraint-wrapper,
    .media-gallery__split-sticky-left .product-media__drag-zoom-wrapper {
      width: 100%;
      max-width: none;
      height: 100%;
      aspect-ratio: auto;
    }

    /* Image covers the full screen area edge-to-edge */
    /* (object-position nahi diya - image ka focal point setting kaam karti rahegi) */
    .media-gallery__split-sticky-left .product-media-container :is(img, video) {
      width: 100%;
      height: 100%;
      aspect-ratio: auto;
      object-fit: cover;
    }

    /* Videos / 3D models bhi full height fill karein */
    .media-gallery__split-sticky-left .product-media :is(deferred-media, product-model) {
      width: 100%;
      height: 100%;
      top: 0;
      left: 0;
    }
  }

  /* Right Column - Scrollable images, LEFT wali image jitni SAME SIZE */
  .media-gallery__split-sticky-right {
    display: flex;
    flex-direction: column;
    gap: var(--image-gap, 4px);
  }

  @media screen and (min-width: 750px) {
    .media-gallery__split-sticky-right .product-media-container {
      width: 100%;
      height: 100vh;
      max-height: none;
      aspect-ratio: auto;
      border-radius: var(--media-radius, 0px);
      overflow: hidden;
      margin: 0 !important;
      background: transparent !important;
    }

    .media-gallery__split-sticky-right .product-media,
    .media-gallery__split-sticky-right .product-media-constraint-wrapper,
    .media-gallery__split-sticky-right .product-media__drag-zoom-wrapper {
      width: 100%;
      max-width: none;
      height: 100%;
      aspect-ratio: auto;
    }

    .media-gallery__split-sticky-right .product-media :is(deferred-media, product-model) {
      width: 100%;
      height: 100%;
      top: 0;
      left: 0;
    }
  }

  /* Saari images (left + right) ek jaisi dikhengi */
  .media-gallery__split-sticky .product-media-container :is(img, video) {
    width: 100%;
    height: 100%;
    aspect-ratio: auto;
    object-fit: cover;
  }

  /* Ensure images fill their container properly */
  .media-gallery__split-sticky .product-media-container img,
  .media-gallery__split-sticky .product-media-container video {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  /* Mobile: hide split-sticky, show carousel/slideshow instead */
  @media screen and (max-width: 749px) {
    .media-gallery__split-sticky {
      display: none !important;
    }
  }
{% endstylesheet %}
