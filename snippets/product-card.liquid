{%- doc -%}
  This snippet is used to render a product card.
  It is used in the product block, featured product block, and the product card block.
  The product object is null or when placeholders are rendered.

  @param {object} product - The product object
  @param {object} children - The children of the product card
  @param {object} [block] - The block object
  @param {number} [product_card_gap] - The gap between the product card children (overrides block settings)
  @param {string} [product_view_context] - The context in which the product card is being rendered. Used for standard events.
{%- enddoc -%}

{% assign block_settings = block.settings %}

{% style %}
  {% if request.visual_preview_mode %}
    product-card[data-product-transition] {
      width: 100%;
      min-width: 250px;
    }
  {% endif %}
{% endstyle %}

{% liquid
  assign has_quick_add = false
  if settings.quick_add and product.available
    assign has_quick_add = true
  endif

  assign has_mobile_quick_add = false
  if has_quick_add and settings.mobile_quick_add
    assign has_mobile_quick_add = true
  endif

  assign product_card_id = 'product-card-link-' | append: block.id | append: '-' | append: product.id
  assign product_card_gap_value = product_card_gap | default: block_settings.product_card_gap

  # Logic to determine which variant URL to use (matching swatch selection logic)
  assign variant_to_link = product.selected_or_first_available_variant

  if settings.transition_to_main_product
    assign featured_image = variant_to_link.featured_image
    if featured_image == blank
      assign featured_image = product.featured_media.preview_image
    endif

    if featured_image != blank
      assign featured_media_url = featured_image | image_url: width: 500
    endif
  endif

  assign onboarding = false
  if product.id == empty or product == blank
    assign onboarding = true
  endif

  if block_settings.background_color != blank
    render 'contrast-override', background_color: block_settings.background_color, text_color: block_settings.text_color, section_id: block.id
  endif
%}

<product-card
  class="product-card size-style"
  style="{% render 'size-style', settings: block_settings %}"
  data-product-id="{{ product.id }}"
  id="product-card-{{ block.id }}"
  {% if settings.transition_to_main_product %}
    data-product-transition="true"
    data-featured-media-url="{{ featured_media_url }}"
    on:click="/handleViewTransition"
  {% endif %}
  {{ block.shopify_attributes }}
  {% if onboarding %}
    data-placeholder="true"
  {% endif %}
  {%- unless onboarding -%}
    {% # theme-check-disable-next-line UnknownFilter %}
    view-event-payload="{{ product | standard_event_data: 'view', context: product_view_context | escape }}"
  {%- endunless -%}
>
  <a
    id="{{ product_card_id | md5 }}"
    {% unless onboarding %}
      href="{{ variant_to_link.url }}"
    {% endunless %}
    class="product-card__link"
    ref="productCardLink"
  >
    <span class="visually-hidden">
      {{ product.title }}
    </span>
  </a>
  <div class="premium-product-card">
    <div class="premium-card-media">
      {% assign downcased_tags = product.tags | join: ',' | downcase %}
      {% if downcased_tags contains 'new arrival' %}
        <span class="badge-new-in">New In</span>
      {% elsif downcased_tags contains 'best selling' %}
        <span class="badge-new-in">Best Selling</span>
      {% endif %}
      
      <a href="/pages/wishlist" class="wishlist-btn-trigger" aria-label="Add to wishlist">
        <svg viewBox="0 0 24 24"><path d="M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z"/></svg>
      </a>

      <a href="{{ variant_to_link.url | default: product.url | default: '#' }}">
        {% if product.featured_media != blank %}
          <img src="{{ product.featured_media | image_url: width: 600 }}" alt="{{ product.featured_media.alt | escape }}" loading="lazy">
        {% else %}
          {{ 'product-1' | placeholder_svg_tag: 'placeholder-svg' }}
        {% endif %}
      </a>

      {% assign has_sizes = false %}
      {% for option in product.options_with_values %}
        {% assign option_name = option.name | downcase %}
        {% if option_name == 'size' %}
          {% assign has_sizes = true %}
        {% endif %}
      {% endfor %}
      {% if has_sizes %}
        <div class="sizes-hover-overlay">
          {% for option in product.options_with_values %}
            {% assign option_name = option.name | downcase %}
            {% if option_name == 'size' %}
              {% for value in option.values limit: 5 %}
                <span class="size-option-item">{{ value }}</span>
              {% endfor %}
            {% endif %}
          {% endfor %}
        </div>
      {% endif %}
    </div>

    <div class="premium-card-info">
      <a href="{{ variant_to_link.url | default: product.url | default: '#' }}" class="p-title">{{ product.title | default: 'Sample Product Title' }}</a>
      <p class="p-price">{% if product.price %}{{ product.price | money }}{% else %}Rs. 5,300{% endif %}</p>

      {% assign has_colors = false %}
      {% for option in product.options_with_values %}
        {% assign option_name = option.name | downcase %}
        {% if option_name == 'color' or option_name == 'colour' %}
          {% assign has_colors = true %}
        {% endif %}
      {% endfor %}
      {% if has_colors %}
        <div class="p-swatches">
          {% assign color_count = 0 %}
          {% for option in product.options_with_values %}
            {% assign option_name = option.name | downcase %}
            {% if option_name == 'color' or option_name == 'colour' %}
              {% for value in option.values %}
                {% if color_count < 3 %}
                  <span class="swatch-circle" style="background-color: {{ value | split: ' ' | last | handle }};" title="{{ value }}"></span>
                  {% assign color_count = color_count | plus: 1 %}
                {% endif %}
              {% endfor %}
              {% if option.values.size > 3 %}
                <span class="swatch-more-count">+{{ option.values.size | minus: 3 }}</span>
              {% endif %}
            {% endif %}
          {% endfor %}
        </div>
      {% endif %}
    </div>
  </div>
</product-card>

{% stylesheet %}
  .product-card__placeholder-image svg {
    height: 100%;
  }

  .product-card__content slideshow-component {
    --cursor: pointer;
  }

  @media screen and (max-width: 749px) {
    .product-card slideshow-arrows .slideshow-control {
      display: none;
    }
  }

  /* Rounded corners on the card gallery image container */
  .product-card .card-gallery {
    position: relative;
    border-radius: 0 !important;
    overflow: hidden !important;
  }

  /* Wishlist Button styling */
  .product-card-wishlist-btn {
    position: absolute !important;
    top: 12px !important;
    right: 12px !important;
    z-index: 12 !important;
    background: transparent !important;
    border: none !important;
    padding: 0 !important;
    cursor: pointer !important;
    color: #fff !important;
    display: flex !important;
    align-items: center !important;
    justify-content: center !important;
    transition: transform 0.2s ease, opacity 0.2s ease !important;
  }

  .product-card-wishlist-btn:hover {
    transform: scale(1.1) !important;
  }

  .product-card-wishlist-btn.is-active svg {
    fill: #fff !important;
    stroke: #fff !important;
  }

  /* Center the pagination dots at the bottom of the image */
  .product-card slideshow-controls {
    position: absolute !important;
    bottom: 12px !important;
    left: 50% !important;
    transform: translateX(-50%) !important;
    justify-content: center !important;
    width: auto !important;
    background: transparent !important;
    padding: 0 !important;
    min-height: auto !important;
    mix-blend-mode: normal !important;
    z-index: 10 !important;
  }

  .product-card .slideshow-controls__dots {
    background: transparent !important;
    padding: 0 !important;
    gap: 6px !important;
    margin: 0 !important;
  }

  .product-card .slideshow-controls__dots button {
    --size: 6px !important;
    width: var(--size) !important;
    height: var(--size) !important;
    margin: 0 !important;
    padding: 0 !important;
    border-radius: 50% !important;
  }

  .product-card .slideshow-controls__dots button::after {
    content: '' !important;
    display: block !important;
    width: 6px !important;
    height: 6px !important;
    background-color: rgba(255, 255, 255, 0.5) !important;
    border-radius: 50% !important;
    box-shadow: 0 0 2px rgba(0, 0, 0, 0.5) !important; /* visibility on white images */
    transition: background-color 0.2s ease !important;
  }

  .product-card .slideshow-controls__dots button[aria-selected='true']::after {
    background-color: #fff !important;
    box-shadow: 0 0 2px rgba(0, 0, 0, 0.8) !important;
  }

  /* Slideshow Arrows inside the card image - made visible on all backgrounds */
  .product-card slideshow-arrows {
    mix-blend-mode: normal !important;
  }

  .product-card slideshow-arrows .slideshow-control--shape-circle {
    background-color: rgba(255, 255, 255, 0.75) !important; /* higher opacity */
    color: #000 !important;
    width: 36px !important;
    height: 36px !important;
    min-width: 36px !important;
    min-height: 36px !important;
    border-radius: 50% !important;
    border: 1px solid rgba(0, 0, 0, 0.1) !important; /* border for visibility on white background */
    box-shadow: 0 2px 5px rgba(0, 0, 0, 0.15) !important; /* shadow for high contrast */
    display: flex !important;
    align-items: center !important;
    justify-content: center !important;
    transition: background-color 0.2s ease, transform 0.2s ease !important;
  }

  .product-card slideshow-arrows .slideshow-control--shape-circle:hover {
    background-color: rgba(255, 255, 255, 0.9) !important;
    transform: scale(1.05) !important;
  }

  .product-card slideshow-arrows .slideshow-control .svg-wrapper {
    width: 14px !important;
    height: 14px !important;
    color: #000 !important;
  }

  .product-card slideshow-arrows .slideshow-control {
    padding: 0 !important;
    margin-inline: 12px !important;
  }

  /* Product Card content and layout using Grid */
  .product-card {
    position: relative !important;
  }

  .product-card__content {
    display: flex !important;
    flex-direction: column !important;
    gap: 8px !important;
    background: transparent !important;
    border: none !important;
  }

  /* Gallery takes full width */
  .product-card__content .card-gallery {
    width: 100% !important;
    margin-bottom: 4px !important;
  }

  /* Remove excessive gaps from internal group blocks to match the tight spacing of the design */
  .product-card__content .group-block,
  .product-card__content .group-block-content {
    gap: 0 !important;
    padding: 0 !important;
    margin: 0 !important;
  }

  /* Title area */
  .product-card__content a[ref="productTitleLink"] {
    grid-area: title !important;
    margin: 0 !important;
    padding: 0 !important;
    width: 100% !important;
    overflow: hidden !important;
    display: block !important;
    min-width: 0 !important; /* Allow column to shrink and truncate long text */
  }

  /* Price area */
  .product-card__content product-price {
    grid-area: price !important;
    margin: 0 !important;
    padding: 0 !important;
    width: 100% !important;
  }

  /* Quick add button area centered next to title & price */
  .product-card__content .quick-add {
    display: none !important;
  }

  /* Overrides to prevent double plus sign displaying */
  .product-card [data-quick-add-button='choose'] add-to-cart-component,
  .product-card [data-quick-add-button='add'] .quick-add__button--choose {
    display: none !important;
  }

  .product-card .quick-add__button {
    display: none !important;
  }

  /* Hide default icons inside quick-add button */
  .product-card .quick-add__button .svg-wrapper,
  .product-card .quick-add__button .add-to-cart-text__content {
    display: none !important;
  }

  /* Draw a clean plus sign instead */
  .product-card .quick-add__button::after {
    content: '+' !important;
    font-size: 24px !important;
    font-weight: 300 !important;
    line-height: 1 !important;
    color: var(--color-foreground) !important;
    display: block !important;
  }

  .product-card .quick-add__button[disabled] {
    opacity: 0.4 !important;
    cursor: not-allowed !important;
  }

  .product-card .quick-add__button[data-added='true']::after {
    display: none !important;
  }

  .product-card .quick-add__button[data-added='true'] .add-to-cart__added {
    display: flex !important;
    align-items: center !important;
    justify-content: center !important;
  }

  /* Details typography style - forced to one line with ellipsis */
  .product-card .product-title h3,
  .product-card .product-title p {
    font-family: var(--font-body--family) !important;
    font-size: 13px !important;
    font-weight: 500 !important;
    text-transform: none !important;
    color: var(--color-foreground) !important;
    line-height: 1.4 !important;
    margin: 8px 0 2px 0 !important;
    letter-spacing: normal !important;
    white-space: nowrap !important;
    overflow: hidden !important;
    text-overflow: ellipsis !important;
    display: block !important;
    width: 100% !important;
  }

  .product-card product-price .price {
    font-family: var(--font-body--family) !important;
    font-size: 12px !important;
    font-weight: 400 !important;
    color: #666 !important;
    margin: 0 !important;
  }

  /* Premium Card Styles overriding global defaults */
  .premium-product-card {
    position: relative;
    display: flex;
    flex-direction: column;
    background: #ffffff;
    width: 100%;
    height: 100%;
  }
  .premium-card-media {
    position: relative;
    width: 100%;
    aspect-ratio: 3 / 4;
    overflow: hidden;
    background-color: #f7f7f7;
  }
  .premium-card-media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.6s cubic-bezier(0.25, 1, 0.5, 1);
  }
  .premium-product-card:hover .premium-card-media img, .product-card:hover .premium-card-media img {
    transform: scale(1.02);
  }
  .badge-new-in {
    position: absolute;
    top: 15px;
    left: 15px;
    background: rgba(255, 255, 255, 0.9);
    color: #000000;
    padding: 4px 10px;
    font-size: 10px;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    border-radius: 12px;
    z-index: 3;
  }
  .wishlist-btn-trigger {
    position: absolute;
    top: 15px;
    right: 15px;
    background: transparent;
    border: none;
    cursor: pointer;
    z-index: 3;
  }
  .wishlist-btn-trigger svg {
    width: 18px;
    height: 18px;
    fill: none;
    stroke: #000000;
    stroke-width: 1.5px;
  }
  .wishlist-btn-trigger:hover svg {
    fill: #000000;
  }
  .sizes-hover-overlay {
    position: absolute;
    bottom: 0;
    left: 0;
    width: 100%;
    background: transparent;
    padding: 15px;
    box-sizing: border-box;
    display: flex;
    justify-content: center;
    gap: 12px;
    transform: translateY(101%);
    transition: transform 0.3s cubic-bezier(0.25, 1, 0.5, 1);
    z-index: 4;
  }
  .premium-product-card:hover .sizes-hover-overlay, .product-card:hover .sizes-hover-overlay {
    transform: translateY(0);
  }
  .size-option-item {
    font-size: 11px;
    color: #000000;
    text-transform: uppercase;
  }
  .premium-card-info {
      padding: 12px 10px;
      display: flex;
      flex-direction: column;
      gap: 4px;
      background: #f7f7f7;
      flex-grow: 1;
  }
  .p-title {
    font-size: 13px;
    font-weight: 400;
    color: #000000;
    text-decoration: none;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .p-price {
    font-size: 13px;
    margin: 0;
    color: #000000;
  }
  .p-swatches {
    display: flex;
    align-items: center;
    gap: 6px;
    margin-top: 4px;
  }
  .swatch-circle {
    width: 12px;
    height: 12px;
    border-radius: 50%;
    border: 1px solid rgba(0,0,0,0.15);
  }
  .swatch-more-count {
    font-size: 11px;
    color: #777777;
  }
  .placeholder-svg {
    width: 100%;
    height: 100%;
    background: #f3f3f3;
  }
{% endstylesheet %}
