<div class="pincode-checker-block" {{ block.shopify_attributes }} style="background-color: {{ block.settings.bg_color }}; border-color: {{ block.settings.border_color }};">
  
  <div class="pincode-checker-header">
    <div class="pincode-checker-icon" style="color: {{ block.settings.icon_color }};">
      <!-- Location Pin Icon -->
      <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" xmlns="http://www.w3.org/2000/svg">
        <path d="M12 2C8.13 2 5 5.13 5 9C5 14.25 12 22 12 22C12 22 19 14.25 19 9C19 5.13 15.87 2 12 2ZM12 11.5C10.62 11.5 9.5 10.38 9.5 9C9.5 7.62 10.62 6.5 12 6.5C13.38 6.5 14.5 7.62 14.5 9C14.5 10.38 13.38 11.5 12 11.5Z"/>
      </svg>
    </div>
    <h3 class="pincode-checker-title" style="color: {{ block.settings.heading_color }}; font-family: inherit;">
      {{ block.settings.heading }}
    </h3>
  </div>

  {% if block.settings.subtext != blank %}
    <p class="pincode-checker-subtext">{{ block.settings.subtext }}</p>
  {% endif %}

  <div class="pincode-checker-form">
    <input 
      type="text" 
      id="pincode-input-{{ block.id }}" 
      class="pincode-checker-input" 
      placeholder="{{ block.settings.placeholder_text }}"
      maxlength="6"
      pattern="[0-9]*"
    >
    <button 
      type="button" 
      id="pincode-btn-{{ block.id }}" 
      class="pincode-checker-button" 
      style="background-color: {{ block.settings.btn_bg_color }}; color: {{ block.settings.btn_text_color }};"
    >
      {{ block.settings.btn_text }}
    </button>
  </div>
  
  <div id="pincode-message-{{ block.id }}" class="pincode-checker-message" style="display: none;"></div>

</div>

<style>
  .pincode-checker-block {
    width: 60%;
    {% comment %} border: 1px solid #ccc; {% endcomment %}
    border-radius: 4px;
    padding: 16px;
    margin-top: {{ block.settings.margin_top }}px;
    margin-bottom: {{ block.settings.margin_bottom }}px;
    box-sizing: border-box;
  }
  .pincode-checker-header {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-bottom: 12px;
  }
  .pincode-checker-icon {
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .pincode-checker-title {
    font-size: 14px;
    font-weight: 700;
    margin: 0;
    letter-spacing: 0.5px;
  }
  .pincode-checker-subtext {
    font-size: 13px;
    color: #555;
    margin: -4px 0 12px 0;
    line-height: 1.4;
  }
  .pincode-checker-form {
    display: flex;
    gap: 8px;
  }
  .pincode-checker-input {
    flex: 1;
    padding: 10px 12px;
    border: 1px solid #e0e0e0;
    border-radius: 4px;
    font-size: 14px;
    outline: none;
    box-shadow: none;
    background: #fff;
    color: #333;
    font-family: inherit;
  }
  .pincode-checker-input:focus {
    border-color: #333;
  }
  .pincode-checker-button {
    padding: 10px 20px;
    border: none;
    border-radius: 4px;
    font-size: 14px;
    font-weight: 700;
    cursor: pointer;
    transition: opacity 0.2s;
    font-family: inherit;
  }
  .pincode-checker-button:hover {
    opacity: 0.9;
  }
  .pincode-checker-message {
    margin-top: 10px;
    font-size: 13px;
    font-weight: 500;
  }
  .pincode-checker-message.success {
    color: #2e7d32;
  }
  .pincode-checker-message.error {
    color: #d32f2f;
  }
  @media screen and (max-width: 767px){
  .pincode-checker-block {
    width: 100%;
    padding: 16px 0;
}
}
</style>

<script>
  document.addEventListener("DOMContentLoaded", function() {
    var checkBtn = document.getElementById('pincode-btn-{{ block.id }}');
    var input = document.getElementById('pincode-input-{{ block.id }}');
    var messageBox = document.getElementById('pincode-message-{{ block.id }}');

    if (checkBtn && input) {
      checkBtn.addEventListener('click', function() {
        var pincode = input.value.trim();
        if (pincode === "") {
          messageBox.style.display = "block";
          messageBox.className = "pincode-checker-message error";
          messageBox.innerText = "Please enter a valid pincode.";
          return;
        }
        
        if (pincode.length < 5) {
          messageBox.style.display = "block";
          messageBox.className = "pincode-checker-message error";
          messageBox.innerText = "Pincode is too short.";
          return;
        }

        // UI Simulation: If it passes basic length check, show available.
        // If an external app like Shiprocket is used, it usually hijacks this button or input by ID/class.
        messageBox.style.display = "block";
        messageBox.className = "pincode-checker-message success";
        messageBox.innerText = "Delivery is available to " + pincode + "!";
      });
    }
  });
</script>

{% schema %}
{
  "name": "Pincode Checker",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "DELIVERY OPTIONS"
    },
    {
      "type": "textarea",
      "id": "subtext",
      "label": "Subtext",
      "default": "Please enter PIN code to check Delivery Availability"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading Color",
      "default": "#004d40"
    },
    {
      "type": "color",
      "id": "icon_color",
      "label": "Icon Color",
      "default": "#c62828"
    },
    {
      "type": "text",
      "id": "placeholder_text",
      "label": "Input Placeholder",
      "default": "Enter pincode"
    },
    {
      "type": "text",
      "id": "btn_text",
      "label": "Button Text",
      "default": "Check"
    },
    {
      "type": "color",
      "id": "btn_bg_color",
      "label": "Button Background Color",
      "default": "#c63842"
    },
    {
      "type": "color",
      "id": "btn_text_color",
      "label": "Button Text Color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Block Background Color",
      "default": "#faf5eb"
    },
    {
      "type": "color",
      "id": "border_color",
      "label": "Block Border Color",
      "default": "#222222"
    },
    {
      "type": "range",
      "id": "margin_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Top margin",
      "default": 16
    },
    {
      "type": "range",
      "id": "margin_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Bottom margin",
      "default": 16
    }
  ],
  "presets": [
    {
      "name": "Pincode Checker"
    }
  ]
}
{% endschema %}
