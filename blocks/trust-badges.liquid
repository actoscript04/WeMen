<div class="trust-badges-block" {{ block.shopify_attributes }}>
  <div class="trust-badges-container">
    {% for i in (1..4) %}
      {% capture item_image_key %}item_{{ i }}_image{% endcapture %}
      {% capture item_svg_key %}item_{{ i }}_svg{% endcapture %}
      {% capture item_text_key %}item_{{ i }}_text{% endcapture %}

      {% assign item_image = block.settings[item_image_key] %}
      {% assign item_svg = block.settings[item_svg_key] %}
      {% assign item_text = block.settings[item_text_key] %}

      {% if item_image != blank or item_svg != blank or item_text != blank %}
        <div class="trust-badge-item">
          <div class="trust-badge-icon" style="width: {{ block.settings.icon_size }}px; height: {{ block.settings.icon_size }}px; color: {{ block.settings.icon_color }};">
            {% if item_image != blank %}
              <img src="{{ item_image | img_url: 'master' }}" alt="{{ item_image.alt | default: item_text | escape }}" style="width: 100%; height: 100%; object-fit: contain;">
            {% elsif item_svg != blank %}
              {{ item_svg }}
            {% endif %}
          </div>
          {% if item_text != blank %}
            <div class="trust-badge-text" style="color: {{ block.settings.text_color }}; font-family: inherit;">
              {{ item_text | newline_to_br }}
            </div>
          {% endif %}
        </div>
        
        {% if forloop.last == false %}
          <div class="trust-badge-divider"></div>
        {% endif %}
      {% endif %}
    {% endfor %}
  </div>
</div>

<style>
  .trust-badges-block {
    width: 100%;
    margin-top: {{ block.settings.margin_top }}px;
    margin-bottom: {{ block.settings.margin_bottom }}px;
    background: {{ block.settings.bg_color }};
    padding: {{ block.settings.padding }}px;
    border-radius: 4px;
  }
  .trust-badges-container {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    width: 100%;
  }
  .trust-badge-item {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    flex: 1;
    padding: 0 5px;
  }
  .trust-badge-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 8px;
  }
  .trust-badge-icon svg {
    width: 100%;
    height: 100%;
  }
  .trust-badge-text {
    font-size: 11px;
    line-height: 1.4;
    font-weight: 500;
  }
  .trust-badge-divider {
    width: 1px;
    background-color: #e0e0e0;
    min-height: 40px;
    align-self: stretch;
    margin: 0 5px;
  }
  @media screen and (max-width: 480px) {
    .trust-badges-container {
      flex-wrap: nowrap;
      overflow-x: auto;
      -webkit-overflow-scrolling: touch;
      scrollbar-width: none;
      -ms-overflow-style: none;
      padding-bottom: 5px;
    }
    .trust-badges-block {
    padding: 12px 0 !important;
  }
    .trust-badges-container::-webkit-scrollbar {
      display: none;
    }
    .trust-badge-item {
      flex: 1 1 0;
      min-width: 72px;
      margin-bottom: 0;
      padding: 0 2px;
    }
    .trust-badge-divider {
      display: block;
      min-height: 30px;
      align-self: center;
      margin: 0 2px;
    }
    .trust-badge-text {
      font-size: 9.5px;
      line-height: 1.2;
      display: -webkit-box;
      -webkit-line-clamp: 2;
      -webkit-box-orient: vertical;
      overflow: hidden;
      text-overflow: ellipsis;
      word-break: break-word;
    }
    .trust-badge-icon {
      width: 24px !important;
      height: 24px !important;
      margin-bottom: 5px;
    }
  }
</style>

