<div class="product-short-description" {{ block.shopify_attributes }}>
  {% assign product_desc = product.description %}
  {% if product_desc == blank and product_resource != blank %}
    {% assign product_desc = product_resource.description %}
  {% endif %}
  
  {% assign limit = block.settings.word_limit | default: 30 %}
  
  {% if block.settings.custom_text != blank %}
    <div class="short-desc-content">
      {{ block.settings.custom_text }}
    </div>
  {% elsif product_desc != blank %}
    <div class="short-desc-content">
      {{ product_desc | strip_html | truncatewords: limit }}
    </div>
  {% endif %}
</div>

<style>
  .product-short-description {
    margin-top: {{ block.settings.margin_top }}px;
    margin-bottom: {{ block.settings.margin_bottom }}px;
    font-size: 14px;
    line-height: 1.6;
    color: var(--color-text-body, #333);
  }
  .short-desc-content p {
    margin: 0 0 10px 0;
  }
  .short-desc-content p:last-child {
    margin-bottom: 0;
  }
</style>

{% schema %}
{
  "name": "Short Description",
  "settings": [
    {
      "type": "richtext",
      "id": "custom_text",
      "label": "Custom Short Description",
      "info": "If left blank, it will automatically show a truncated version of the main product description."
    },
    {
      "type": "range",
      "id": "word_limit",
      "min": 10,
      "max": 100,
      "step": 5,
      "label": "Auto-truncate Word Limit",
      "default": 30
    },
    {
      "type": "range",
      "id": "margin_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Top margin",
      "default": 16
    },
    {
      "type": "range",
      "id": "margin_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Bottom margin",
      "default": 16
    }
  ],
  "presets": [
    {
      "name": "Short Description"
    }
  ]
}
{% endschema %}
